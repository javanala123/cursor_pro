//@version=6
strategy("Pattern Trading Bot - 최종 수정판", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=2)

// ============================================================================
// 설정
// ============================================================================
start_date = input.time(timestamp("2019-01-01 00:00"), "백테스트 시작일")
end_date = input.time(timestamp("2024-01-01 00:00"), "백테스트 종료일")

min_confidence = input.float(0.4, "최소 신뢰도", minval=0.0, maxval=1.0)
min_strength = input.float(0.2, "최소 강도", minval=0.0, maxval=1.0)

// ============================================================================
// 패턴 감지 (수정된 버전)
// ============================================================================

// 1. 엔걸핑 패턴 (정확한 로직)
detect_engulfing() =>
    // 상승 엔걸핑: 이전 캔들이 음봉이고, 현재 캔들이 양봉이며, 현재 캔들이 이전 캔들을 완전히 감쌈
    bullish_engulfing = close[1] < open[1] and close > open and close > open[1] and open < close[1]
    // 하락 엔걸핑: 이전 캔들이 양봉이고, 현재 캔들이 음봉이며, 현재 캔들이 이전 캔들을 완전히 감쌈
    bearish_engulfing = close[1] > open[1] and close < open and close < open[1] and open > close[1]
    [bullish_engulfing, bearish_engulfing]

// 2. 해머 패턴 (수정된 로직)
detect_hammer() =>
    body_size = math.abs(close - open)
    lower_shadow = math.min(open, close) - low  // 이제 정확함
    upper_shadow = high - math.max(open, close)
    total_range = high - low
    
    // 해머 조건: 아랫꼬리가 몸통의 2배 이상, 윗꼬리는 몸통보다 작음
    hammer = lower_shadow > 2 * body_size and upper_shadow < body_size and total_range > 0
    [hammer, false]

// 3. 도지 패턴 (개선된 로직)
detect_doji() =>
    body_size = math.abs(close - open)
    total_range = high - low
    // 도지 조건: 몸통이 전체 범위의 5% 이하 (더 엄격)
    doji = total_range > 0 and body_size <= total_range * 0.05
    [doji, doji]

// 4. 더블 바텀 패턴 (간단하고 정확한 로직)
detect_double_bottom() =>
    // 최근 20개 바에서 피벗 로우 찾기
    pivot_low = ta.pivotlow(low, 10, 10)
    double_bottom = false
    
    if not na(pivot_low)
        // 이전 피벗 로우와 비교
        prev_pivot = ta.pivotlow(low, 10, 10)[10]
        if not na(prev_pivot)
            // 두 피벗이 비슷한 높이인지 확인 (현재 범위의 2% 이내)
            range_avg = ta.sma(high - low, 20)
            if math.abs(pivot_low - prev_pivot) <= range_avg * 0.02
                double_bottom := true
    
    [double_bottom, false]

// 5. 더블 탑 패턴 (간단하고 정확한 로직)
detect_double_top() =>
    // 최근 20개 바에서 피벗 하이 찾기
    pivot_high = ta.pivothigh(high, 10, 10)
    double_top = false
    
    if not na(pivot_high)
        // 이전 피벗 하이와 비교
        prev_pivot = ta.pivothigh(high, 10, 10)[10]
        if not na(prev_pivot)
            // 두 피벗이 비슷한 높이인지 확인 (현재 범위의 2% 이내)
            range_avg = ta.sma(high - low, 20)
            if math.abs(pivot_high - prev_pivot) <= range_avg * 0.02
                double_top := true
    
    [false, double_top]

// ============================================================================
// 패턴 강도 및 신뢰도 계산 (개선된 버전)
// ============================================================================

calculate_pattern_strength(pattern_type, is_bullish) =>
    strength = switch pattern_type
        "engulfing" => 
            body_size = math.abs(close - open)
            prev_body_size = math.abs(close[1] - open[1])
            prev_body_size > 0 ? math.min(1.0, body_size / prev_body_size) : 0.0
        "hammer" => 
            body_size = math.abs(close - open)
            lower_shadow = math.min(open, close) - low
            total_range = high - low
            total_range > 0 ? math.min(1.0, lower_shadow / total_range) : 0.0
        "doji" => 
            body_size = math.abs(close - open)
            total_range = high - low
            total_range > 0 ? 1.0 - (body_size / total_range) : 0.0
        "double_bottom" => 0.8
        "double_top" => 0.8
        => 0.0
    strength

calculate_pattern_confidence(pattern_type, is_bullish) =>
    confidence = switch pattern_type
        "engulfing" => 0.85
        "hammer" => 0.80
        "doji" => 0.75
        "double_bottom" => 0.90
        "double_top" => 0.90
        => 0.0
    confidence

// ============================================================================
// 거래 조건 및 실행
// ============================================================================

// 거래 가능한 시간인지 확인
in_trading_time = time >= start_date and time <= end_date

// 포지션이 없을 때만 거래
no_position = strategy.position_size == 0

// 거래 조건 확인
should_enter_trade(confidence, strength) =>
    confidence >= min_confidence and strength >= min_strength and in_trading_time and no_position

// 수익 목표 계산 (개선된 버전 - 모든 자산에 적용 가능)
calculate_profit_target(profit_pct) =>
    close * profit_pct

// ============================================================================
// 패턴 감지 및 거래 실행
// ============================================================================

// 패턴 감지
[bull_engulfing, bear_engulfing] = detect_engulfing()
[bull_hammer, _] = detect_hammer()
[bull_doji, _] = detect_doji()
[bull_double_bottom, _] = detect_double_bottom()
[_, bear_double_top] = detect_double_top()

// 라벨 관리 (중복 방지)
var label current_label = na

// 1. 엔걸핑 패턴 거래
if bull_engulfing
    confidence = calculate_pattern_confidence("engulfing", true)
    strength = calculate_pattern_strength("engulfing", true)
    if should_enter_trade(confidence, strength)
        strategy.entry("LONG_ENGULF", strategy.long)
        profit_target = calculate_profit_target(0.01)  // 1% 수익 목표
        strategy.exit("LONG_ENGULF_EXIT", "LONG_ENGULF", limit=close + profit_target)
        
        // 라벨 표시
        label.delete(current_label)
        current_label := label.new(bar_index, low, "🟢 엔걸핑\nC:" + str.tostring(confidence, "#.##") + " S:" + str.tostring(strength, "#.##"), 
                                 color=color.green, textcolor=color.white, style=label.style_label_up)

if bear_engulfing
    confidence = calculate_pattern_confidence("engulfing", false)
    strength = calculate_pattern_strength("engulfing", false)
    if should_enter_trade(confidence, strength)
        strategy.entry("SHORT_ENGULF", strategy.short)
        profit_target = calculate_profit_target(0.01)  // 1% 수익 목표
        strategy.exit("SHORT_ENGULF_EXIT", "SHORT_ENGULF", limit=close - profit_target)
        
        // 라벨 표시
        label.delete(current_label)
        current_label := label.new(bar_index, high, "🔴 엔걸핑\nC:" + str.tostring(confidence, "#.##") + " S:" + str.tostring(strength, "#.##"), 
                                 color=color.red, textcolor=color.white, style=label.style_label_down)

// 2. 해머 패턴 거래
if bull_hammer
    confidence = calculate_pattern_confidence("hammer", true)
    strength = calculate_pattern_strength("hammer", true)
    if should_enter_trade(confidence, strength)
        strategy.entry("LONG_HAMMER", strategy.long)
        profit_target = calculate_profit_target(0.01)  // 1% 수익 목표
        strategy.exit("LONG_HAMMER_EXIT", "LONG_HAMMER", limit=close + profit_target)
        
        // 라벨 표시
        label.delete(current_label)
        current_label := label.new(bar_index, low, "🔨 해머\nC:" + str.tostring(confidence, "#.##") + " S:" + str.tostring(strength, "#.##"), 
                                 color=color.blue, textcolor=color.white, style=label.style_label_up)

// 3. 도지 패턴 거래 (추세 방향으로)
if bull_doji
    confidence = calculate_pattern_confidence("doji", true)
    strength = calculate_pattern_strength("doji", true)
    if should_enter_trade(confidence, strength)
        // 도지는 불확실성 신호이므로 추세 방향으로 거래
        if close > close[1]  // 상승 추세
            strategy.entry("LONG_DOJI", strategy.long)
            profit_target = calculate_profit_target(0.005)  // 0.5% 수익 목표 (보수적)
            strategy.exit("LONG_DOJI_EXIT", "LONG_DOJI", limit=close + profit_target)
            
            // 라벨 표시
            label.delete(current_label)
            current_label := label.new(bar_index, low, "⚪ 도지(상승)\nC:" + str.tostring(confidence, "#.##") + " S:" + str.tostring(strength, "#.##"), 
                                     color=color.lime, textcolor=color.black, style=label.style_label_up)
        else  // 하락 추세
            strategy.entry("SHORT_DOJI", strategy.short)
            profit_target = calculate_profit_target(0.005)  // 0.5% 수익 목표 (보수적)
            strategy.exit("SHORT_DOJI_EXIT", "SHORT_DOJI", limit=close - profit_target)
            
            // 라벨 표시
            label.delete(current_label)
            current_label := label.new(bar_index, high, "⚪ 도지(하락)\nC:" + str.tostring(confidence, "#.##") + " S:" + str.tostring(strength, "#.##"), 
                                     color=color.orange, textcolor=color.white, style=label.style_label_down)

// 4. 더블 바텀 패턴 거래
if bull_double_bottom
    confidence = calculate_pattern_confidence("double_bottom", true)
    strength = calculate_pattern_strength("double_bottom", true)
    if should_enter_trade(confidence, strength)
        strategy.entry("LONG_DOUBLE_BOTTOM", strategy.long)
        profit_target = calculate_profit_target(0.02)  // 2% 수익 목표 (더 큰 목표)
        strategy.exit("LONG_DOUBLE_BOTTOM_EXIT", "LONG_DOUBLE_BOTTOM", limit=close + profit_target)
        
        // 라벨 표시
        label.delete(current_label)
        current_label := label.new(bar_index, low, "📈 더블바텀\nC:" + str.tostring(confidence, "#.##") + " S:" + str.tostring(strength, "#.##"), 
                                 color=color.purple, textcolor=color.white, style=label.style_label_up)

// 5. 더블 탑 패턴 거래
if bear_double_top
    confidence = calculate_pattern_confidence("double_top", false)
    strength = calculate_pattern_strength("double_top", false)
    if should_enter_trade(confidence, strength)
        strategy.entry("SHORT_DOUBLE_TOP", strategy.short)
        profit_target = calculate_profit_target(0.02)  // 2% 수익 목표 (더 큰 목표)
        strategy.exit("SHORT_DOUBLE_TOP_EXIT", "SHORT_DOUBLE_TOP", limit=close - profit_target)
        
        // 라벨 표시
        label.delete(current_label)
        current_label := label.new(bar_index, high, "📉 더블탑\nC:" + str.tostring(confidence, "#.##") + " S:" + str.tostring(strength, "#.##"), 
                                 color=color.maroon, textcolor=color.white, style=label.style_label_down)
