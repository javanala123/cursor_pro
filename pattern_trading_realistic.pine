//@version=6
strategy("현실적 패턴 거래 전략", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=2)

// ============================================================================
// 설정
// ============================================================================

// 백테스트 기간
start_date = input.time(timestamp("2020-01-01 00:00"), "백테스트 시작일")
end_date = input.time(timestamp("2025-09-13 00:00"), "백테스트 종료일")

// 패턴 설정 (더 엄격한 조건)
pattern_length = input.int(10, "패턴 길이 (캔들 수)", minval=5, maxval=20)
min_similarity = input.float(0.85, "최소 유사도", minval=0.7, maxval=1.0)  // 60% → 85%로 강화
min_confidence = input.float(0.8, "최소 신뢰도", minval=0.5, maxval=1.0)   // 50% → 80%로 강화

// 거래 설정 (더 현실적)
base_profit_pct = input.float(0.03, "기본 수익 목표 (%)", minval=0.01, maxval=0.1)
max_profit_pct = input.float(0.08, "최대 수익 목표 (%)", minval=0.02, maxval=0.2)
stop_loss_pct = input.float(0.02, "손절매 (%)", minval=0.01, maxval=0.05)

// 거래 제한 (과도한 거래 방지)
max_trades_per_day = input.int(3, "일일 최대 거래 수", minval=1, maxval=10)
min_bars_between_trades = input.int(5, "거래 간 최소 바 수", minval=1, maxval=20)

// 디버깅
show_patterns = input.bool(true, "패턴 표시")
show_similarity = input.bool(true, "유사도 표시")

// ============================================================================
// 실제 시장 패턴 추출 (하드코딩 제거)
// ============================================================================

// 실제 시장에서 성공한 패턴들을 동적으로 추출
extract_real_patterns() =>
    var array<array<float>> pattern_highs = array.new<array<float>>()
    var array<array<float>> pattern_lows = array.new<array<float>>()
    var array<array<float>> pattern_opens = array.new<array<float>>()
    var array<array<float>> pattern_closes = array.new<array<float>>()
    var array<float> pattern_returns = array.new<float>()
    var array<string> pattern_names = array.new<string>()
    
    // 최근 1000개 바에서 성공한 패턴 추출
    if barstate.isconfirmed and bar_index > 1000
        // 상승 패턴 찾기 (10개 바 후 3% 이상 상승)
        for i = 100 to bar_index - 10
            if close[i + 10] > close[i] * 1.03  // 3% 이상 상승
                // 패턴 데이터 수집
                pattern_high = array.new<float>()
                pattern_low = array.new<float>()
                pattern_open = array.new<float>()
                pattern_close = array.new<float>()
                
                for j = 0 to pattern_length - 1
                    array.push(pattern_high, high[i + j])
                    array.push(pattern_low, low[i + j])
                    array.push(pattern_open, open[i + j])
                    array.push(pattern_close, close[i + j])
                
                // 패턴 저장
                array.push(pattern_highs, pattern_high)
                array.push(pattern_lows, pattern_low)
                array.push(pattern_opens, pattern_open)
                array.push(pattern_closes, pattern_close)
                array.push(pattern_returns, (close[i + 10] - close[i]) / close[i])
                array.push(pattern_names, "상승패턴_" + str.tostring(i))
                
                // 최대 50개 패턴만 저장
                if array.size(pattern_returns) >= 50
                    break
    
    [pattern_highs, pattern_lows, pattern_opens, pattern_closes, pattern_returns, pattern_names]

// ============================================================================
// 개선된 유사도 계산
// ============================================================================

// 정규화된 유사도 계산 (평균 대신 표준편차 사용)
calculate_normalized_similarity(arr1, arr2) =>
    if array.size(arr1) != array.size(arr2) or array.size(arr1) == 0
        0.0
    else
        // 표준편차로 정규화
        mean1 = array.avg(arr1)
        mean2 = array.avg(arr2)
        
        std1 = 0.0
        std2 = 0.0
        
        for i = 0 to array.size(arr1) - 1
            std1 += math.pow(array.get(arr1, i) - mean1, 2)
            std2 += math.pow(array.get(arr2, i) - mean2, 2)
        
        std1 := math.sqrt(std1 / array.size(arr1))
        std2 := math.sqrt(std2 / array.size(arr2))
        
        if std1 == 0 or std2 == 0
            0.0
        else
            // 정규화된 데이터로 코사인 유사도 계산
            dot_product = 0.0
            norm1_sq = 0.0
            norm2_sq = 0.0
            
            for i = 0 to array.size(arr1) - 1
                val1 = (array.get(arr1, i) - mean1) / std1
                val2 = (array.get(arr2, i) - mean2) / std2
                dot_product += val1 * val2
                norm1_sq += val1 * val1
                norm2_sq += val2 * val2
            
            if norm1_sq > 0 and norm2_sq > 0
                dot_product / (math.sqrt(norm1_sq) * math.sqrt(norm2_sq))
            else
                0.0

// ============================================================================
// 거래 제한 로직
// ============================================================================

// 거래 카운터
var int daily_trade_count = 0
var int last_trade_bar = 0

// 거래 가능 여부 확인
can_trade_now() =>
    // 일일 거래 수 제한
    if daily_trade_count >= max_trades_per_day
        false
    // 거래 간 최소 바 수 확인
    else if bar_index - last_trade_bar < min_bars_between_trades
        false
    else
        true

// 거래 카운터 업데이트
update_trade_count() =>
    daily_trade_count := daily_trade_count + 1
    last_trade_bar := bar_index

// ============================================================================
// 메인 거래 로직
// ============================================================================

// 실제 패턴 추출
[pattern_highs, pattern_lows, pattern_opens, pattern_closes, pattern_returns, pattern_names] = extract_real_patterns()

// 현재 패턴
var array<float> current_high = array.new<float>()
var array<float> current_low = array.new<float>()
var array<float> current_open = array.new<float>()
var array<float> current_close = array.new<float>()

// 현재 패턴 업데이트
if barstate.isconfirmed
    array.clear(current_high)
    array.clear(current_low)
    array.clear(current_open)
    array.clear(current_close)
    
    for i = 0 to pattern_length - 1
        array.push(current_high, high[i])
        array.push(current_low, low[i])
        array.push(current_open, open[i])
        array.push(current_close, close[i])

// 최적 패턴 찾기
find_best_real_pattern() =>
    if array.size(pattern_returns) == 0 or array.size(current_high) < pattern_length
        [0.0, 0.0, 0, "없음"]
    else
        max_similarity = 0.0
        best_return = 0.0
        best_pattern_idx = 0
        best_pattern_name = "없음"
        
        // 모든 실제 패턴과 비교
        for i = 0 to array.size(pattern_returns) - 1
            pattern_high = array.get(pattern_highs, i)
            pattern_low = array.get(pattern_lows, i)
            pattern_open = array.get(pattern_opens, i)
            pattern_close = array.get(pattern_closes, i)
            
            // 각 데이터 타입별 유사도 계산
            high_sim = calculate_normalized_similarity(current_high, pattern_high)
            low_sim = calculate_normalized_similarity(current_low, pattern_low)
            open_sim = calculate_normalized_similarity(current_open, pattern_open)
            close_sim = calculate_normalized_similarity(current_close, pattern_close)
            
            // 가중 평균
            avg_similarity = (high_sim * 0.3 + low_sim * 0.3 + open_sim * 0.2 + close_sim * 0.2)
            
            if avg_similarity > max_similarity
                max_similarity := avg_similarity
                best_return := array.get(pattern_returns, i)
                best_pattern_idx := i
                best_pattern_name := array.get(pattern_names, i)
        
        [max_similarity, best_return, best_pattern_idx, best_pattern_name]

// ============================================================================
// 거래 실행
// ============================================================================

// 거래 조건
in_trading_time = time >= start_date and time <= end_date
no_position = strategy.position_size == 0

// 최적 패턴 찾기
[similarity, expected_return, pattern_idx, pattern_name] = find_best_real_pattern()

// 거래 신호 (더 엄격한 조건)
should_enter_long = similarity >= min_similarity and expected_return > 0.02 and in_trading_time and no_position and can_trade_now()

// 동적 수익 목표 계산
calculate_dynamic_targets(expected_return) =>
    var float profit_pct = 0.0
    
    if expected_return > 0.05
        profit_pct := math.min(max_profit_pct, expected_return * 0.6)
    else if expected_return > 0.03
        profit_pct := math.min(max_profit_pct * 0.8, expected_return * 0.7)
    else
        profit_pct := base_profit_pct
    
    profit_target = close * profit_pct
    stop_loss = close * stop_loss_pct
    [profit_target, stop_loss, profit_pct]

// 거래 실행
if should_enter_long
    [profit_target, stop_loss, profit_pct] = calculate_dynamic_targets(expected_return)
    strategy.entry("LONG_PATTERN", strategy.long)
    strategy.exit("LONG_PATTERN_EXIT", "LONG_PATTERN", limit=close + profit_target, stop=close - stop_loss)
    update_trade_count()
    
    if show_patterns
        label.new(bar_index, low, "🟢 " + pattern_name + "\n유사도: " + str.tostring(similarity, "#.##") + "\n예상수익: " + str.tostring(expected_return * 100, "#.#") + "%\n목표: " + str.tostring(profit_pct * 100, "#.#") + "%", 
                 color=color.green, textcolor=color.white, style=label.style_label_up)

// ============================================================================
// 디버깅 정보
// ============================================================================

if show_similarity and barstate.isconfirmed
    var table debug_table = table.new(position.top_right, 2, 8, bgcolor=color.white, border_width=1)
    
    table.cell(debug_table, 0, 0, "패턴 정보", text_color=color.black, bgcolor=color.gray)
    table.cell(debug_table, 1, 0, "값", text_color=color.black, bgcolor=color.gray)
    
    table.cell(debug_table, 0, 1, "패턴명", text_color=color.black)
    table.cell(debug_table, 1, 1, pattern_name, text_color=color.black)
    
    table.cell(debug_table, 0, 2, "유사도", text_color=color.black)
    table.cell(debug_table, 1, 2, str.tostring(similarity, "#.##"), text_color=similarity >= min_similarity ? color.green : color.red)
    
    table.cell(debug_table, 0, 3, "예상수익", text_color=color.black)
    table.cell(debug_table, 1, 3, str.tostring(expected_return * 100, "#.#") + "%", text_color=expected_return > 0.02 ? color.green : color.red)
    
    table.cell(debug_table, 0, 4, "거래가능", text_color=color.black)
    table.cell(debug_table, 1, 4, can_trade_now() ? "✅" : "❌", text_color=can_trade_now() ? color.green : color.red)
    
    table.cell(debug_table, 0, 5, "일일거래수", text_color=color.black)
    table.cell(debug_table, 1, 5, str.tostring(daily_trade_count) + "/" + str.tostring(max_trades_per_day), text_color=color.black)
    
    table.cell(debug_table, 0, 6, "포지션", text_color=color.black)
    table.cell(debug_table, 1, 6, strategy.position_size > 0 ? "LONG" : "NONE", text_color=color.black)
    
    table.cell(debug_table, 0, 7, "패턴수", text_color=color.black)
    table.cell(debug_table, 1, 7, str.tostring(array.size(pattern_returns)), text_color=color.black)
