//@version=6
strategy("AI 강화 패턴 거래 시스템", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=2)

// ============================================================================
// 사용자 조절 가능한 설정
// ============================================================================

// 백테스트 기간
start_date = input.time(timestamp("2020-01-01 00:00"), "백테스트 시작일")
end_date = input.time(timestamp("2025-09-13 00:00"), "백테스트 종료일")

// 패턴 설정 (사용자 조절 가능)
pattern_length = input.int(150, "패턴 길이 (캔들 수)", minval=100, maxval=200)  // 100-200캔들
min_similarity = input.float(0.80, "최소 유사도", minval=0.60, maxval=0.95)     // 사용자 조절
min_ai_confidence = input.float(0.75, "최소 AI 신뢰도", minval=0.50, maxval=0.95)  // AI 분석 신뢰도

// 핍 기준 설정 (사용자 조절 가능)
min_profit_pips_1st = input.float(50, "1차 최소 수익 (핍)", minval=20, maxval=100)
min_profit_pips_2nd = input.float(100, "2차 최소 수익 (핍)", minval=50, maxval=200)
max_patterns_used = input.int(50, "사용할 패턴 수 (상위 N개)", minval=10, maxval=100)

// 거래 설정
profit_target_pct = input.float(0.015, "수익 목표 (%)", minval=0.005, maxval=0.05)
stop_loss_pct = input.float(0.025, "손절매 (%)", minval=0.01, maxval=0.05)

// AI 이미지 분석 설정
enable_ai_analysis = input.bool(true, "AI 이미지 분석 활성화")
image_analysis_accuracy = input.float(0.85, "이미지 분석 정확도", minval=0.70, maxval=0.95)
enable_ai_exit = input.bool(true, "AI 청산/손절 활성화")

// 시각화 설정
show_pattern_projection = input.bool(true, "패턴 투영 표시")
show_ai_analysis = input.bool(true, "AI 분석 결과 표시")
show_pattern_ranking = input.bool(true, "패턴 순위 표시")

// ============================================================================
// AI 강화 패턴 데이터베이스
// ============================================================================

type AIPattern
    array<float> high_data
    array<float> low_data
    array<float> open_data
    array<float> close_data
    array<float> volume_data
    float profit_pips
    int success_level  // 1: 50핍, 2: 100핍
    float success_rate
    int ranking
    string pattern_name
    string pattern_type
    float ai_confidence  // AI 분석 신뢰도
    array<float> image_features  // 이미지 특징 벡터

// AI 강화 패턴 DB
var array<AIPattern> ai_patterns = array.new<AIPattern>()

// AI 이미지 특징 추출 (간소화된 버전)
extract_image_features(pattern_data) =>
    var array<float> features = array.new<float>()
    array.clear(features)
    
    // 1. 패턴의 전체적인 기울기
    if array.size(pattern_data) > 1
        start_val = array.get(pattern_data, 0)
        end_val = array.get(pattern_data, array.size(pattern_data) - 1)
        slope = (end_val - start_val) / array.size(pattern_data)
        array.push(features, slope)
    
    // 2. 변동성 (표준편차)
    mean_val = array.avg(pattern_data)
    variance = 0.0
    for i = 0 to array.size(pattern_data) - 1
        variance += math.pow(array.get(pattern_data, i) - mean_val, 2)
    std_dev = math.sqrt(variance / array.size(pattern_data))
    array.push(features, std_dev)
    
    // 3. 최고점과 최저점의 비율
    max_val = array.max(pattern_data)
    min_val = array.min(pattern_data)
    if min_val > 0
        range_ratio = (max_val - min_val) / min_val
        array.push(features, range_ratio)
    
    // 4. 상승/하락 비율
    up_count = 0
    down_count = 0
    for i = 1 to array.size(pattern_data) - 1
        if array.get(pattern_data, i) > array.get(pattern_data, i-1)
            up_count += 1
        else
            down_count += 1
    
    if up_count + down_count > 0
        up_ratio = up_count / (up_count + down_count)
        array.push(features, up_ratio)
    
    features

// AI 패턴 유사도 계산 (이미지 특징 기반)
calculate_ai_similarity(pattern1, pattern2) =>
    if array.size(pattern1) != array.size(pattern2) or array.size(pattern1) == 0
        0.0
    else
        // 이미지 특징 추출
        features1 = extract_image_features(pattern1)
        features2 = extract_image_features(pattern2)
        
        if array.size(features1) != array.size(features2)
            0.0
        else
            // 특징 벡터 간 코사인 유사도
            dot_product = 0.0
            norm1_sq = 0.0
            norm2_sq = 0.0
            
            for i = 0 to array.size(features1) - 1
                val1 = array.get(features1, i)
                val2 = array.get(features2, i)
                dot_product += val1 * val2
                norm1_sq += val1 * val1
                norm2_sq += val2 * val2
            
            if norm1_sq > 0 and norm2_sq > 0
                dot_product / (math.sqrt(norm1_sq) * math.sqrt(norm2_sq))
            else
                0.0

// AI 패턴 DB 초기화 (1시간 타임프레임, 비트코인 전용)
init_ai_patterns() =>
    if array.size(ai_patterns) == 0
        // 실제로는 5-10년 1시간 비트코인 데이터에서 추출
        // 예시: 상위 패턴들만 하드코딩
        
        // 패턴 1: 강력한 반전 패턴 (150캔들, 100핍 수익)
        pattern1 = AIPattern.new()
        pattern1.high_data := array.new<float>()
        pattern1.low_data := array.new<float>()
        pattern1.open_data := array.new<float>()
        pattern1.close_data := array.new<float>()
        pattern1.volume_data := array.new<float>()
        
        // 150캔들 패턴 생성 (실제로는 과거 데이터에서 추출)
        for i = 0 to pattern_length - 1
            if i < 100
                // 하락 추세 (100캔들)
                base_price = 50000 - i * 50
                array.push(pattern1.high_data, base_price + 100)
                array.push(pattern1.low_data, base_price - 50)
                array.push(pattern1.open_data, base_price + 20)
                array.push(pattern1.close_data, base_price - 30)
            else
                // 반전 시작 (50캔들)
                base_price = 50000 - 100 * 50 + (i - 100) * 80
                array.push(pattern1.high_data, base_price + 150)
                array.push(pattern1.low_data, base_price - 20)
                array.push(pattern1.open_data, base_price + 10)
                array.push(pattern1.close_data, base_price + 120)
            array.push(pattern1.volume_data, 1000000 + i * 5000)
        
        pattern1.profit_pips := 100.0
        pattern1.success_level := 2
        pattern1.success_rate := 1.0  // 성공한 패턴만 저장하므로 100%
        pattern1.ranking := 1
        pattern1.pattern_name := "강력반전_100핍_150캔들"
        pattern1.pattern_type := "Reversal"
        pattern1.ai_confidence := 0.92
        pattern1.image_features := extract_image_features(pattern1.close_data)
        array.push(ai_patterns, pattern1)
        
        // 패턴 2: 엔걸핑 반전 (150캔들, 80핍 수익)
        pattern2 = AIPattern.new()
        pattern2.high_data := array.new<float>()
        pattern2.low_data := array.new<float>()
        pattern2.open_data := array.new<float>()
        pattern2.close_data := array.new<float>()
        pattern2.volume_data := array.new<float>()
        
        for i = 0 to pattern_length - 1
            if i < 148
                base_price = 50000 - i * 30
                array.push(pattern2.high_data, base_price + 80)
                array.push(pattern2.low_data, base_price - 40)
                array.push(pattern2.open_data, base_price + 20)
                array.push(pattern2.close_data, base_price - 10)
            else if i == 148
                // 이전 음봉
                base_price = 50000 - 148 * 30
                array.push(pattern2.high_data, base_price + 80)
                array.push(pattern2.low_data, base_price - 40)
                array.push(pattern2.open_data, base_price + 20)
                array.push(pattern2.close_data, base_price - 30)
            else
                // 엔걸핑 양봉
                base_price = 50000 - 148 * 30
                array.push(pattern2.high_data, base_price + 120)
                array.push(pattern2.low_data, base_price - 30)
                array.push(pattern2.open_data, base_price - 30)
                array.push(pattern2.close_data, base_price + 80)
            array.push(pattern2.volume_data, 1000000 + i * 3000)
        
        pattern2.profit_pips := 80.0
        pattern2.success_level := 2
        pattern2.success_rate := 1.0  // 성공한 패턴만 저장하므로 100%
        pattern2.ranking := 2
        pattern2.pattern_name := "엔걸핑반전_80핍_150캔들"
        pattern2.pattern_type := "Engulfing"
        pattern2.ai_confidence := 0.87
        pattern2.image_features := extract_image_features(pattern2.close_data)
        array.push(ai_patterns, pattern2)

// ============================================================================
// AI 실시간 패턴 감시
// ============================================================================

// 현재 차트 패턴 (150캔들)
var array<float> current_high = array.new<float>()
var array<float> current_low = array.new<float>()
var array<float> current_open = array.new<float>()
var array<float> current_close = array.new<float>()
var array<float> current_volume = array.new<float>()

// 현재 패턴 업데이트
update_current_pattern() =>
    if barstate.isconfirmed
        array.clear(current_high)
        array.clear(current_low)
        array.clear(current_open)
        array.clear(current_close)
        array.clear(current_volume)
        
        for i = 0 to pattern_length - 1
            array.push(current_high, high[i])
            array.push(current_low, low[i])
            array.push(current_open, open[i])
            array.push(current_close, close[i])
            array.push(current_volume, volume[i])

// AI 기반 최적 패턴 매칭
find_ai_best_pattern() =>
    if array.size(ai_patterns) == 0 or array.size(current_high) < pattern_length
        [0.0, 0.0, 0, "없음", "없음", 0.0, 0, 0.0]
    else
        max_similarity = 0.0
        best_profit = 0.0
        best_pattern_idx = 0
        best_pattern_name = "없음"
        best_pattern_type = "없음"
        best_success_rate = 0.0
        best_ranking = 0
        best_ai_confidence = 0.0
        
        // 상위 N개 패턴만 비교 (성능 최적화)
        max_compare = math.min(max_patterns_used, array.size(ai_patterns))
        
        for i = 0 to max_compare - 1
            pattern = array.get(ai_patterns, i)
            
            if enable_ai_analysis
                // AI 이미지 분석 기반 유사도
                high_sim = calculate_ai_similarity(current_high, pattern.high_data)
                low_sim = calculate_ai_similarity(current_low, pattern.low_data)
                open_sim = calculate_ai_similarity(current_open, pattern.open_data)
                close_sim = calculate_ai_similarity(current_close, pattern.close_data)
                volume_sim = calculate_ai_similarity(current_volume, pattern.volume_data)
            else
                // 기존 수치 기반 유사도
                high_sim = calculate_vector_similarity(current_high, pattern.high_data)
                low_sim = calculate_vector_similarity(current_low, pattern.low_data)
                open_sim = calculate_vector_similarity(current_open, pattern.open_data)
                close_sim = calculate_vector_similarity(current_close, pattern.close_data)
                volume_sim = calculate_vector_similarity(current_volume, pattern.volume_data)
            
            // 가중 평균 유사도
            avg_similarity = (high_sim * 0.25 + low_sim * 0.25 + open_sim * 0.2 + close_sim * 0.2 + volume_sim * 0.1)
            
            // AI 신뢰도 적용
            if enable_ai_analysis
                ai_adjusted_similarity = avg_similarity * pattern.ai_confidence
            else
                ai_adjusted_similarity = avg_similarity
            
            if ai_adjusted_similarity > max_similarity
                max_similarity := ai_adjusted_similarity
                best_profit := pattern.profit_pips
                best_pattern_idx := i
                best_pattern_name := pattern.pattern_name
                best_pattern_type := pattern.pattern_type
                best_success_rate := pattern.success_rate
                best_ranking := pattern.ranking
                best_ai_confidence := pattern.ai_confidence
        
        [max_similarity, best_profit, best_pattern_idx, best_pattern_name, best_pattern_type, best_success_rate, best_ranking, best_ai_confidence]

// 기존 벡터 유사도 계산 (AI 비활성화 시 사용)
calculate_vector_similarity(vec1, vec2) =>
    if array.size(vec1) != array.size(vec2) or array.size(vec1) == 0
        0.0
    else
        mean1 = array.avg(vec1)
        mean2 = array.avg(vec2)
        
        std1 = 0.0
        std2 = 0.0
        
        for i = 0 to array.size(vec1) - 1
            std1 += math.pow(array.get(vec1, i) - mean1, 2)
            std2 += math.pow(array.get(vec2, i) - mean2, 2)
        
        std1 := math.sqrt(std1 / array.size(vec1))
        std2 := math.sqrt(std2 / array.size(vec2))
        
        if std1 == 0 or std2 == 0
            0.0
        else
            dot_product = 0.0
            norm1_sq = 0.0
            norm2_sq = 0.0
            
            for i = 0 to array.size(vec1) - 1
                val1 = (array.get(vec1, i) - mean1) / std1
                val2 = (array.get(vec2, i) - mean2) / std2
                dot_product += val1 * val2
                norm1_sq += val1 * val1
                norm2_sq += val2 * val2
            
            if norm1_sq > 0 and norm2_sq > 0
                dot_product / (math.sqrt(norm1_sq) * math.sqrt(norm2_sq))
            else
                0.0

// ============================================================================
// AI 기반 청산/손절 판단
// ============================================================================

// AI 청산 신호 생성
generate_ai_exit_signal() =>
    if not enable_ai_exit
        false
    else
        // 현재 포지션의 수익률 계산
        if strategy.position_size > 0
            current_profit_pct = (close - strategy.position_avg_price) / strategy.position_avg_price
            current_loss_pct = (strategy.position_avg_price - close) / strategy.position_avg_price
            
            // AI 기반 청산 조건
            // 1. 목표 수익 달성
            if current_profit_pct >= profit_target_pct
                true
            // 2. 손절 조건
            else if current_loss_pct >= stop_loss_pct
                true
            // 3. AI 패턴 분석 기반 청산 (추가 로직)
            else
                // 현재 패턴이 반전 신호를 보이면 청산
                [current_similarity, current_profit, current_idx, current_name, current_type, current_success_rate, current_ranking, current_ai_confidence] = find_ai_best_pattern()
                
                // 반대 패턴이 감지되면 청산
                if current_similarity < min_similarity * 0.7
                    true
                else
                    false
        else
            false

// ============================================================================
// 패턴 투영 및 시각화
// ============================================================================

// AI 패턴 투영 (실차트에 표시)
draw_ai_pattern_projection(pattern_idx, similarity) =>
    if show_pattern_projection and pattern_idx < array.size(ai_patterns)
        pattern = array.get(ai_patterns, pattern_idx)
        
        // 패턴의 미래 예측 경로 그리기 (50캔들 앞까지)
        for i = 0 to 50
            future_bar = bar_index + i
            if i < array.size(pattern.close_data)
                pred_close = array.get(pattern.close_data, i)
                pred_high = array.get(pattern.high_data, i)
                pred_low = array.get(pattern.low_data, i)
                
                // AI 신뢰도에 따른 색상 조정
                confidence_color = similarity > 0.9 ? color.yellow : similarity > 0.8 ? color.orange : color.gray
                
                // 예측 라인 그리기
                line.new(bar_index, close, future_bar, pred_close, 
                        color=confidence_color, width=3, style=line.style_dashed)
                line.new(bar_index, high, future_bar, pred_high, 
                        color=color.green, width=2, style=line.style_dotted)
                line.new(bar_index, low, future_bar, pred_low, 
                        color=color.red, width=2, style=line.style_dotted)

// ============================================================================
// 메인 거래 로직
// ============================================================================

// AI 패턴 DB 초기화
init_ai_patterns()

// 현재 패턴 업데이트
update_current_pattern()

// AI 기반 최적 패턴 매칭
[similarity, expected_profit, pattern_idx, pattern_name, pattern_type, success_rate, ranking, ai_confidence] = find_ai_best_pattern()

// 거래 조건
in_trading_time = time >= start_date and time <= end_date
no_position = strategy.position_size == 0
should_enter = similarity >= min_similarity and expected_profit >= min_profit_pips_1st and ai_confidence >= min_ai_confidence and in_trading_time and no_position

// AI 청산 신호
ai_exit_signal = generate_ai_exit_signal()

// 거래 실행
if should_enter
    strategy.entry("AI_LONG_PATTERN", strategy.long)
    strategy.exit("AI_LONG_PATTERN_EXIT", "AI_LONG_PATTERN", limit=close + close * profit_target_pct, stop=close - close * stop_loss_pct)
    
    // AI 패턴 투영 표시
    draw_ai_pattern_projection(pattern_idx, similarity)
    
    // 진입 라벨
    label.new(bar_index, low, 
        "🤖 AI " + pattern_name + "\n" +
        "순위: #" + str.tostring(ranking) + "\n" +
        "유사도: " + str.tostring(similarity, "#.##") + "\n" +
        "AI신뢰도: " + str.tostring(ai_confidence, "#.##") + "\n" +
        "예상수익: " + str.tostring(expected_profit, "#") + "핍\n" +
        "성공률: " + str.tostring(success_rate * 100, "#.#") + "%", 
        color=color.green, textcolor=color.white, style=label.style_label_up)

// AI 청산 실행
if ai_exit_signal and strategy.position_size > 0
    strategy.close("AI_LONG_PATTERN")
    
    if show_ai_analysis
        label.new(bar_index, high, 
            "🤖 AI 청산\n" +
            "AI 분석 기반\n" +
            "최적 타이밍", 
            color=color.orange, textcolor=color.white, style=label.style_label_down)

// ============================================================================
// AI 분석 결과 표시
// ============================================================================

if show_ai_analysis and barstate.isconfirmed
    var table ai_table = table.new(position.top_right, 2, 8, bgcolor=color.white, border_width=1)
    
    table.cell(ai_table, 0, 0, "AI 분석", text_color=color.black, bgcolor=color.gray)
    table.cell(ai_table, 1, 0, "결과", text_color=color.black, bgcolor=color.gray)
    
    table.cell(ai_table, 0, 1, "패턴명", text_color=color.black)
    table.cell(ai_table, 1, 1, pattern_name, text_color=color.black)
    
    table.cell(ai_table, 0, 2, "유사도", text_color=color.black)
    table.cell(ai_table, 1, 2, str.tostring(similarity, "#.##"), text_color=similarity >= min_similarity ? color.green : color.red)
    
    table.cell(ai_table, 0, 3, "AI신뢰도", text_color=color.black)
    table.cell(ai_table, 1, 3, str.tostring(ai_confidence, "#.##"), text_color=ai_confidence > 0.8 ? color.green : color.orange)
    
    table.cell(ai_table, 0, 4, "예상수익", text_color=color.black)
    table.cell(ai_table, 1, 4, str.tostring(expected_profit, "#") + "핍", text_color=expected_profit >= min_profit_pips_1st ? color.green : color.red)
    
    table.cell(ai_table, 0, 5, "성공률", text_color=color.black)
    table.cell(ai_table, 1, 5, str.tostring(success_rate * 100, "#.#") + "%", text_color=color.black)
    
    table.cell(ai_table, 0, 6, "거래가능", text_color=color.black)
    table.cell(ai_table, 1, 6, should_enter ? "✅" : "❌", text_color=should_enter ? color.green : color.red)
    
    table.cell(ai_table, 0, 7, "AI청산", text_color=color.black)
    table.cell(ai_table, 1, 7, ai_exit_signal ? "🤖" : "⏳", text_color=ai_exit_signal ? color.orange : color.gray)

// ============================================================================
// 패턴 순위 표시
// ============================================================================

if show_pattern_ranking and barstate.isconfirmed
    var table ranking_table = table.new(position.top_left, 4, 6, bgcolor=color.white, border_width=1)
    
    table.cell(ranking_table, 0, 0, "순위", text_color=color.black, bgcolor=color.gray)
    table.cell(ranking_table, 1, 0, "패턴명", text_color=color.black, bgcolor=color.gray)
    table.cell(ranking_table, 2, 0, "수익(핍)", text_color=color.black, bgcolor=color.gray)
    table.cell(ranking_table, 3, 0, "AI신뢰도", text_color=color.black, bgcolor=color.gray)
    
    for i = 0 to math.min(5, array.size(ai_patterns) - 1)
        pattern = array.get(ai_patterns, i)
        table.cell(ranking_table, 0, i + 1, "#" + str.tostring(pattern.ranking), text_color=color.black)
        table.cell(ranking_table, 1, i + 1, pattern.pattern_name, text_color=color.black)
        table.cell(ranking_table, 2, i + 1, str.tostring(pattern.profit_pips, "#") + "핍", text_color=color.black)
        table.cell(ranking_table, 3, i + 1, str.tostring(pattern.ai_confidence, "#.##"), text_color=pattern.ai_confidence > 0.8 ? color.green : color.orange)
