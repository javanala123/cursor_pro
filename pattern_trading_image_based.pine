//@version=6
strategy("이미지 기반 패턴 거래 전략", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=2)

// ============================================================================
// 설정
// ============================================================================

// 백테스트 기간
start_date = input.time(timestamp("2020-01-01 00:00"), "백테스트 시작일")
end_date = input.time(timestamp("2025-09-13 00:00"), "백테스트 종료일")

// 패턴 설정
pattern_length = input.int(20, "패턴 길이 (캔들 수)", minval=5, maxval=50)
min_similarity = input.float(0.6, "최소 유사도", minval=0.5, maxval=1.0)  // 80% → 60%로 완화
min_confidence = input.float(0.5, "최소 신뢰도", minval=0.0, maxval=1.0)  // 70% → 50%로 완화

// 거래 설정 (동적 수익 목표)
base_profit_pct = input.float(0.02, "기본 수익 목표 (%)", minval=0.005, maxval=0.1)  // 1% → 2%로 증가
max_profit_pct = input.float(0.05, "최대 수익 목표 (%)", minval=0.01, maxval=0.2)    // 최대 5%
stop_loss_pct = input.float(0.015, "손절매 (%)", minval=0.005, maxval=0.1)  // 2% → 1.5%로 조정

// 디버깅
show_patterns = input.bool(true, "패턴 표시")
show_similarity = input.bool(true, "유사도 표시")

// ============================================================================
// 패턴 이미지 데이터베이스
// ============================================================================

// 패턴을 이미지로 저장하는 구조
type PatternImage
    float[] high_data
    float[] low_data
    float[] open_data
    float[] close_data
    float[] volume_data
    float expected_return
    string pattern_name
    int pattern_type  // 1: 상승, -1: 하락, 0: 중립

// 패턴 DB 초기화
var array<PatternImage> pattern_db = array.new<PatternImage>()

// 성공한 패턴들을 이미지로 저장
init_pattern_images() =>
    if array.size(pattern_db) == 0
        // 패턴 1: 강한 상승 패턴
        pattern1 = PatternImage.new()
        pattern1.high_data := array.new<float>()
        pattern1.low_data := array.new<float>()
        pattern1.open_data := array.new<float>()
        pattern1.close_data := array.new<float>()
        pattern1.volume_data := array.new<float>()
        
        for i = 0 to pattern_length - 1
            array.push(pattern1.high_data, 100 + i * 0.5)
            array.push(pattern1.low_data, 99 + i * 0.5)
            array.push(pattern1.open_data, 99.5 + i * 0.5)
            array.push(pattern1.close_data, 100 + i * 0.5)
            array.push(pattern1.volume_data, 1000 + i * 100)
        
        pattern1.expected_return := 0.08  // 5% → 8%로 증가
        pattern1.pattern_name := "강한상승"
        pattern1.pattern_type := 1
        array.push(pattern_db, pattern1)
        
        // 패턴 2: 엔걸핑 패턴
        pattern2 = PatternImage.new()
        pattern2.high_data := array.new<float>()
        pattern2.low_data := array.new<float>()
        pattern2.open_data := array.new<float>()
        pattern2.close_data := array.new<float>()
        pattern2.volume_data := array.new<float>()
        
        for i = 0 to pattern_length - 1
            if i == pattern_length - 2
                array.push(pattern2.high_data, 100 + i * 0.3)
                array.push(pattern2.low_data, 99 + i * 0.3)
                array.push(pattern2.open_data, 99.8 + i * 0.3)
                array.push(pattern2.close_data, 99.2 + i * 0.3)
            else if i == pattern_length - 1
                array.push(pattern2.high_data, 100.5 + i * 0.3)
                array.push(pattern2.low_data, 99.2 + i * 0.3)
                array.push(pattern2.open_data, 99.2 + i * 0.3)
                array.push(pattern2.close_data, 100.3 + i * 0.3)
            else
                array.push(pattern2.high_data, 100 + i * 0.3)
                array.push(pattern2.low_data, 99.5 + i * 0.3)
                array.push(pattern2.open_data, 99.7 + i * 0.3)
                array.push(pattern2.close_data, 99.8 + i * 0.3)
            array.push(pattern2.volume_data, 1000 + i * 50)
        
        pattern2.expected_return := 0.12  // 8% → 12%로 증가
        pattern2.pattern_name := "엔걸핑"
        pattern2.pattern_type := 1
        array.push(pattern_db, pattern2)
        
        // 패턴 3: 해머 패턴
        pattern3 = PatternImage.new()
        pattern3.high_data := array.new<float>()
        pattern3.low_data := array.new<float>()
        pattern3.open_data := array.new<float>()
        pattern3.close_data := array.new<float>()
        pattern3.volume_data := array.new<float>()
        
        for i = 0 to pattern_length - 1
            if i == pattern_length - 1
                array.push(pattern3.high_data, 100 + i * 0.2)
                array.push(pattern3.low_data, 98 + i * 0.2)
                array.push(pattern3.open_data, 99.8 + i * 0.2)
                array.push(pattern3.close_data, 99.9 + i * 0.2)
            else
                array.push(pattern3.high_data, 100 + i * 0.2)
                array.push(pattern3.low_data, 99.5 + i * 0.2)
                array.push(pattern3.open_data, 99.7 + i * 0.2)
                array.push(pattern3.close_data, 99.8 + i * 0.2)
            array.push(pattern3.volume_data, 1000 + i * 80)
        
        pattern3.expected_return := 0.10  // 6% → 10%로 증가
        pattern3.pattern_name := "해머"
        pattern3.pattern_type := 1
        array.push(pattern_db, pattern3)
        
        // 패턴 4: 더블 바텀 패턴 (추가)
        pattern4 = PatternImage.new()
        pattern4.high_data := array.new<float>()
        pattern4.low_data := array.new<float>()
        pattern4.open_data := array.new<float>()
        pattern4.close_data := array.new<float>()
        pattern4.volume_data := array.new<float>()
        
        for i = 0 to pattern_length - 1
            if i < 8 or i > 12
                array.push(pattern4.high_data, 100 + i * 0.1)
                array.push(pattern4.low_data, 99.5 + i * 0.1)
                array.push(pattern4.open_data, 99.7 + i * 0.1)
                array.push(pattern4.close_data, 99.8 + i * 0.1)
            else
                array.push(pattern4.high_data, 100 + i * 0.1)
                array.push(pattern4.low_data, 99.2 + i * 0.1)
                array.push(pattern4.open_data, 99.4 + i * 0.1)
                array.push(pattern4.close_data, 99.6 + i * 0.1)
            array.push(pattern4.volume_data, 1000 + i * 60)
        
        pattern4.expected_return := 0.15  // 15% 수익
        pattern4.pattern_name := "더블바텀"
        pattern4.pattern_type := 1
        array.push(pattern_db, pattern4)
        
        // 패턴 5: 상승 추세 패턴 (추가)
        pattern5 = PatternImage.new()
        pattern5.high_data := array.new<float>()
        pattern5.low_data := array.new<float>()
        pattern5.open_data := array.new<float>()
        pattern5.close_data := array.new<float>()
        pattern5.volume_data := array.new<float>()
        
        for i = 0 to pattern_length - 1
            array.push(pattern5.high_data, 100 + i * 0.8)
            array.push(pattern5.low_data, 99.5 + i * 0.8)
            array.push(pattern5.open_data, 99.7 + i * 0.8)
            array.push(pattern5.close_data, 100 + i * 0.8)
            array.push(pattern5.volume_data, 1000 + i * 120)
        
        pattern5.expected_return := 0.20  // 20% 수익
        pattern5.pattern_name := "상승추세"
        pattern5.pattern_type := 1
        array.push(pattern_db, pattern5)

// ============================================================================
// 이미지 기반 패턴 비교
// ============================================================================

// 현재 차트 패턴을 이미지로 캡처
get_current_pattern_image() =>
    var PatternImage current_pattern = PatternImage.new()
    current_pattern.high_data := array.new<float>()
    current_pattern.low_data := array.new<float>()
    current_pattern.open_data := array.new<float>()
    current_pattern.close_data := array.new<float>()
    current_pattern.volume_data := array.new<float>()
    
    if barstate.isconfirmed
        array.clear(current_pattern.high_data)
        array.clear(current_pattern.low_data)
        array.clear(current_pattern.open_data)
        array.clear(current_pattern.close_data)
        array.clear(current_pattern.volume_data)
        
        for i = 0 to pattern_length - 1
            array.push(current_pattern.high_data, high[i])
            array.push(current_pattern.low_data, low[i])
            array.push(current_pattern.open_data, open[i])
            array.push(current_pattern.close_data, close[i])
            array.push(current_pattern.volume_data, volume[i])
    
    current_pattern

// 배열 유사도 계산 (정규화 후 코사인 유사도)
calculate_array_similarity(arr1, arr2) =>
    if array.size(arr1) != array.size(arr2) or array.size(arr1) == 0
        0.0
    else
        // 정규화
        norm1 = array.avg(arr1)
        norm2 = array.avg(arr2)
        
        if norm1 == 0 or norm2 == 0
            0.0
        else
            dot_product = 0.0
            norm1_sq = 0.0
            norm2_sq = 0.0
            
            for i = 0 to array.size(arr1) - 1
                val1 = array.get(arr1, i) / norm1
                val2 = array.get(arr2, i) / norm2
                dot_product += val1 * val2
                norm1_sq += val1 * val1
                norm2_sq += val2 * val2
            
            if norm1_sq > 0 and norm2_sq > 0
                dot_product / (math.sqrt(norm1_sq) * math.sqrt(norm2_sq))
            else
                0.0

// 이미지 유사도 계산 (정규화된 데이터 비교)
calculate_image_similarity(pattern1, pattern2) =>
    if array.size(pattern1.high_data) != array.size(pattern2.high_data)
        0.0
    else
        // 각 데이터 타입별 유사도 계산
        high_sim = calculate_array_similarity(pattern1.high_data, pattern2.high_data)
        low_sim = calculate_array_similarity(pattern1.low_data, pattern2.low_data)
        open_sim = calculate_array_similarity(pattern1.open_data, pattern2.open_data)
        close_sim = calculate_array_similarity(pattern1.close_data, pattern2.close_data)
        volume_sim = calculate_array_similarity(pattern1.volume_data, pattern2.volume_data)
        
        // 가중 평균 (OHLC에 더 높은 가중치)
        (high_sim * 0.25 + low_sim * 0.25 + open_sim * 0.2 + close_sim * 0.2 + volume_sim * 0.1)

// 최적 패턴 찾기
find_best_pattern() =>
    current_pattern = get_current_pattern_image()
    
    if array.size(current_pattern.high_data) < pattern_length
        [0.0, 0.0, 0, "없음"]
    else
        max_similarity = 0.0
        best_return = 0.0
        best_pattern_idx = 0
        best_pattern_name = "없음"
        
        // DB의 모든 패턴과 비교
        for i = 0 to array.size(pattern_db) - 1
            db_pattern = array.get(pattern_db, i)
            similarity = calculate_image_similarity(current_pattern, db_pattern)
            
            if similarity > max_similarity
                max_similarity := similarity
                best_return := db_pattern.expected_return
                best_pattern_idx := i
                best_pattern_name := db_pattern.pattern_name
        
        [max_similarity, best_return, best_pattern_idx, best_pattern_name]

// ============================================================================
// 거래 실행
// ============================================================================

// 거래 조건
in_trading_time = time >= start_date and time <= end_date
no_position = strategy.position_size == 0

// 패턴 DB 초기화
init_pattern_images()

// 최적 패턴 찾기
[similarity, expected_return, pattern_idx, pattern_name] = find_best_pattern()

// 거래 신호
should_enter_long = similarity >= min_similarity and expected_return > 0 and in_trading_time and no_position
should_enter_short = similarity >= min_similarity and expected_return < 0 and in_trading_time and no_position

// 동적 수익 목표 계산 (패턴별 차별화)
calculate_targets(expected_return) =>
    var float profit_pct = 0.0  // 함수 내에서 변수 선언
    
    // 예상 수익률에 따라 수익 목표 조정
    if expected_return > 0.15
        profit_pct := math.min(max_profit_pct, expected_return * 0.8)  // 최대 80% 활용
    else if expected_return > 0.10
        profit_pct := math.min(max_profit_pct * 0.8, expected_return * 0.7)  // 70% 활용
    else if expected_return > 0.05
        profit_pct := math.min(max_profit_pct * 0.6, expected_return * 0.6)  // 60% 활용
    else
        profit_pct := base_profit_pct  // 기본 수익 목표
    
    profit_target = close * profit_pct
    stop_loss = close * stop_loss_pct
    [profit_target, stop_loss, profit_pct]

// 수익 목표 계산 (전역 변수로 선언)
var float current_profit_pct = 0.0

// 거래 실행
if should_enter_long
    [profit_target, stop_loss, profit_pct] = calculate_targets(expected_return)
    current_profit_pct := profit_pct
    strategy.entry("LONG_PATTERN", strategy.long)
    strategy.exit("LONG_PATTERN_EXIT", "LONG_PATTERN", limit=close + profit_target, stop=close - stop_loss)
    
    if show_patterns
        label.new(bar_index, low, "🟢 " + pattern_name + "\n유사도: " + str.tostring(similarity, "#.##") + "\n예상수익: " + str.tostring(expected_return * 100, "#.#") + "%\n목표: " + str.tostring(current_profit_pct * 100, "#.#") + "%", 
                 color=color.green, textcolor=color.white, style=label.style_label_up)

if should_enter_short
    [profit_target, stop_loss, profit_pct] = calculate_targets(expected_return)
    current_profit_pct := profit_pct
    strategy.entry("SHORT_PATTERN", strategy.short)
    strategy.exit("SHORT_PATTERN_EXIT", "SHORT_PATTERN", limit=close - profit_target, stop=close + stop_loss)
    
    if show_patterns
        label.new(bar_index, high, "🔴 " + pattern_name + "\n유사도: " + str.tostring(similarity, "#.##") + "\n예상수익: " + str.tostring(expected_return * 100, "#.#") + "%\n목표: " + str.tostring(current_profit_pct * 100, "#.#") + "%", 
                 color=color.red, textcolor=color.white, style=label.style_label_down)

// ============================================================================
// 디버깅 정보
// ============================================================================

if show_similarity and barstate.isconfirmed
    var table debug_table = table.new(position.top_right, 2, 6, bgcolor=color.white, border_width=1)
    
    table.cell(debug_table, 0, 0, "패턴 정보", text_color=color.black, bgcolor=color.gray)
    table.cell(debug_table, 1, 0, "값", text_color=color.black, bgcolor=color.gray)
    
    table.cell(debug_table, 0, 1, "패턴명", text_color=color.black)
    table.cell(debug_table, 1, 1, pattern_name, text_color=color.black)
    
    table.cell(debug_table, 0, 2, "유사도", text_color=color.black)
    table.cell(debug_table, 1, 2, str.tostring(similarity, "#.##"), text_color=similarity >= min_similarity ? color.green : color.red)
    
    table.cell(debug_table, 0, 3, "예상수익", text_color=color.black)
    table.cell(debug_table, 1, 3, str.tostring(expected_return * 100, "#.#") + "%", text_color=expected_return > 0 ? color.green : color.red)
    
    table.cell(debug_table, 0, 4, "거래가능", text_color=color.black)
    table.cell(debug_table, 1, 4, (should_enter_long or should_enter_short) ? "✅" : "❌", text_color=(should_enter_long or should_enter_short) ? color.green : color.red)
    
    table.cell(debug_table, 0, 5, "포지션", text_color=color.black)
    table.cell(debug_table, 1, 5, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "NONE", text_color=color.black)
