//@version=6
strategy("Pattern Trading Bot - 간단 버전", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=2)

// ============================================================================
// 설정
// ============================================================================

// 백테스트 기간
start_date = input.time(timestamp("2019-01-01 00:00"), "백테스트 시작일")
end_date = input.time(timestamp("2024-01-01 00:00"), "백테스트 종료일")

// 간단한 패턴 감지 설정
min_confidence = input.float(0.3, "최소 신뢰도", minval=0.0, maxval=1.0)
min_strength = input.float(0.2, "최소 강도", minval=0.0, maxval=1.0)

// ============================================================================
// 간단한 패턴 감지
// ============================================================================

// 1. 엔걸핑 패턴 (매우 간단)
bullish_engulfing = close[1] < open[1] and close > open and close > open[1] and open < close[1]
bearish_engulfing = close[1] > open[1] and close < open and close < open[1] and open > close[1]

// 2. 해머 패턴 (매우 간단)
body_size = math.abs(close - open)
lower_shadow = math.min(open, close) - low
upper_shadow = high - math.max(open, close)
hammer = lower_shadow > 2 * body_size and upper_shadow < body_size

// 3. 도지 패턴 (매우 간단)
doji = body_size < (high - low) * 0.1

// 4. 상승/하락 추세 (매우 간단)
uptrend = close > close[1] and close[1] > close[2]
downtrend = close < close[1] and close[1] < close[2]

// ============================================================================
// 패턴 강도 및 신뢰도 (간단)
// ============================================================================

get_confidence(pattern_type) =>
    if pattern_type == "engulfing"
        0.8
    else if pattern_type == "hammer"
        0.7
    else if pattern_type == "doji"
        0.6
    else if pattern_type == "trend"
        0.5
    else
        0.4

get_strength(pattern_type) =>
    if pattern_type == "engulfing"
        math.min(1.0, body_size / math.abs(close[1] - open[1]))
    else if pattern_type == "hammer"
        math.min(1.0, lower_shadow / (high - low))
    else if pattern_type == "doji"
        1.0 - (body_size / (high - low))
    else if pattern_type == "trend"
        0.6
    else
        0.3

// ============================================================================
// 거래 조건
// ============================================================================

// 거래 가능한 시간인지 확인
in_trading_time = time >= start_date and time <= end_date

// 포지션이 없을 때만 거래
no_position = strategy.position_size == 0

// ============================================================================
// 거래 실행
// ============================================================================

// 1. 엔걸핑 패턴 거래
if bullish_engulfing and in_trading_time and no_position
    confidence = get_confidence("engulfing")
    strength = get_strength("engulfing")
    if confidence >= min_confidence and strength >= min_strength
        strategy.entry("LONG_ENGULF", strategy.long)
        strategy.exit("LONG_EXIT", "LONG_ENGULF", limit=close * 1.01)  // 1% 수익 목표

if bearish_engulfing and in_trading_time and no_position
    confidence = get_confidence("engulfing")
    strength = get_strength("engulfing")
    if confidence >= min_confidence and strength >= min_strength
        strategy.entry("SHORT_ENGULF", strategy.short)
        strategy.exit("SHORT_EXIT", "SHORT_ENGULF", limit=close * 0.99)  // 1% 수익 목표

// 2. 해머 패턴 거래
if hammer and in_trading_time and no_position
    confidence = get_confidence("hammer")
    strength = get_strength("hammer")
    if confidence >= min_confidence and strength >= min_strength
        strategy.entry("LONG_HAMMER", strategy.long)
        strategy.exit("LONG_HAMMER_EXIT", "LONG_HAMMER", limit=close * 1.01)

// 3. 도지 패턴 거래 (반대 방향)
if doji and in_trading_time and no_position
    confidence = get_confidence("doji")
    strength = get_strength("doji")
    if confidence >= min_confidence and strength >= min_strength
        // 도지는 불확실성 신호이므로 추세 방향으로 거래
        if close > close[1]
            strategy.entry("LONG_DOJI", strategy.long)
            strategy.exit("LONG_DOJI_EXIT", "LONG_DOJI", limit=close * 1.01)
        else
            strategy.entry("SHORT_DOJI", strategy.short)
            strategy.exit("SHORT_DOJI_EXIT", "SHORT_DOJI", limit=close * 0.99)

// 4. 추세 거래
if uptrend and in_trading_time and no_position
    confidence = get_confidence("trend")
    strength = get_strength("trend")
    if confidence >= min_confidence and strength >= min_strength
        strategy.entry("LONG_TREND", strategy.long)
        strategy.exit("LONG_TREND_EXIT", "LONG_TREND", limit=close * 1.02)

if downtrend and in_trading_time and no_position
    confidence = get_confidence("trend")
    strength = get_strength("trend")
    if confidence >= min_confidence and strength >= min_strength
        strategy.entry("SHORT_TREND", strategy.short)
        strategy.exit("SHORT_TREND_EXIT", "SHORT_TREND", limit=close * 0.98)

// ============================================================================
// 차트 표시 (디버깅)
// ============================================================================

// 패턴 표시
if bullish_engulfing
    label.new(bar_index, low, "🟢 엔걸핑", color=color.green, textcolor=color.white, style=label.style_label_up)

if bearish_engulfing
    label.new(bar_index, high, "🔴 엔걸핑", color=color.red, textcolor=color.white, style=label.style_label_down)

if hammer
    label.new(bar_index, low, "🔨 해머", color=color.blue, textcolor=color.white, style=label.style_label_up)

if doji
    label.new(bar_index, close, "⚪ 도지", color=color.gray, textcolor=color.white, style=label.style_label_center)

if uptrend
    label.new(bar_index, low, "📈 상승", color=color.lime, textcolor=color.black, style=label.style_label_up)

if downtrend
    label.new(bar_index, high, "📉 하락", color=color.orange, textcolor=color.white, style=label.style_label_down)
