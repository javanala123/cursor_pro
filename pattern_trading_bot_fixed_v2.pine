//@version=6
strategy("Pattern Trading Bot - 수정판 v2", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=2)

// ============================================================================
// 설정 (매우 관대한 조건으로 설정)
// ============================================================================

// 백테스트 기간
start_date = input.time(timestamp("2019-01-01 00:00"), "백테스트 시작일")
end_date = input.time(timestamp("2024-01-01 00:00"), "백테스트 종료일")

// 매우 관대한 패턴 감지 설정
min_confidence = input.float(0.1, "최소 신뢰도", minval=0.0, maxval=1.0)
min_strength = input.float(0.1, "최소 강도", minval=0.0, maxval=1.0)

// 수익 목표 설정 (매우 작은 목표)
profit_target_pct = input.float(0.005, "수익 목표 (%)", minval=0.001, maxval=0.1)
stop_loss_pct = input.float(0.01, "손절매 (%)", minval=0.005, maxval=0.05)

// 디버깅 모드
debug_mode = input.bool(true, "디버깅 모드")

// ============================================================================
// 간단한 패턴 감지 (확실히 감지되는 패턴들)
// ============================================================================

// 1. 상승 엔걸핑 (매우 간단한 조건)
detect_bullish_engulfing() =>
    // 이전 캔들이 음봉이고, 현재 캔들이 양봉
    prev_bearish = close[1] < open[1]
    curr_bullish = close > open
    // 현재 캔들이 이전 캔들을 감쌈
    engulfs = close > open[1] and open < close[1]
    prev_bearish and curr_bullish and engulfs

// 2. 하락 엔걸핑 (매우 간단한 조건)
detect_bearish_engulfing() =>
    // 이전 캔들이 양봉이고, 현재 캔들이 음봉
    prev_bullish = close[1] > open[1]
    curr_bearish = close < open
    // 현재 캔들이 이전 캔들을 감쌈
    engulfs = close < open[1] and open > close[1]
    prev_bullish and curr_bearish and engulfs

// 3. 해머 패턴 (간단한 조건)
detect_hammer() =>
    body_size = math.abs(close - open)
    lower_shadow = math.min(open, close) - low
    upper_shadow = high - math.max(open, close)
    total_range = high - low
    
    // 해머 조건: 아랫꼬리가 몸통의 1.5배 이상, 윗꼬리는 몸통보다 작음
    hammer_condition = lower_shadow > 1.5 * body_size and upper_shadow < body_size and total_range > 0
    hammer_condition

// 4. 도지 패턴 (간단한 조건)
detect_doji() =>
    body_size = math.abs(close - open)
    total_range = high - low
    // 도지 조건: 몸통이 전체 범위의 10% 이하
    doji_condition = total_range > 0 and body_size <= total_range * 0.1
    doji_condition

// 5. 상승 추세 (간단한 조건)
detect_uptrend() =>
    // 최근 3개 캔들이 상승 추세
    close > close[1] and close[1] > close[2]

// 6. 하락 추세 (간단한 조건)
detect_downtrend() =>
    // 최근 3개 캔들이 하락 추세
    close < close[1] and close[1] < close[2]

// ============================================================================
// 거래 조건 (매우 관대한 조건)
// ============================================================================

// 거래 가능한 시간인지 확인
in_trading_time = time >= start_date and time <= end_date

// 포지션이 없을 때만 거래
no_position = strategy.position_size == 0

// 거래 조건 (매우 관대)
should_enter_trade() =>
    in_trading_time and no_position

// ============================================================================
// 수익 목표 및 손절매 계산
// ============================================================================

calculate_targets() =>
    profit_target = close * profit_target_pct
    stop_loss = close * stop_loss_pct
    [profit_target, stop_loss]

// ============================================================================
// 패턴 감지 및 거래 실행
// ============================================================================

// 패턴 감지
bull_engulfing = detect_bullish_engulfing()
bear_engulfing = detect_bearish_engulfing()
hammer = detect_hammer()
doji = detect_doji()
uptrend = detect_uptrend()
downtrend = detect_downtrend()

// 라벨 관리
var label current_label = na

// 1. 상승 엔걸핑 거래
if bull_engulfing and should_enter_trade()
    [profit_target, stop_loss] = calculate_targets()
    strategy.entry("LONG_ENGULF", strategy.long)
    strategy.exit("LONG_ENGULF_EXIT", "LONG_ENGULF", limit=close + profit_target, stop=close - stop_loss)
    
    if debug_mode
        label.delete(current_label)
        current_label := label.new(bar_index, low, "🟢 상승 엔걸핑", color=color.green, textcolor=color.white, style=label.style_label_up)

// 2. 하락 엔걸핑 거래
if bear_engulfing and should_enter_trade()
    [profit_target, stop_loss] = calculate_targets()
    strategy.entry("SHORT_ENGULF", strategy.short)
    strategy.exit("SHORT_ENGULF_EXIT", "SHORT_ENGULF", limit=close - profit_target, stop=close + stop_loss)
    
    if debug_mode
        label.delete(current_label)
        current_label := label.new(bar_index, high, "🔴 하락 엔걸핑", color=color.red, textcolor=color.white, style=label.style_label_down)

// 3. 해머 패턴 거래 (상승 신호)
if hammer and should_enter_trade()
    [profit_target, stop_loss] = calculate_targets()
    strategy.entry("LONG_HAMMER", strategy.long)
    strategy.exit("LONG_HAMMER_EXIT", "LONG_HAMMER", limit=close + profit_target, stop=close - stop_loss)
    
    if debug_mode
        label.delete(current_label)
        current_label := label.new(bar_index, low, "🔨 해머", color=color.blue, textcolor=color.white, style=label.style_label_up)

// 4. 도지 패턴 거래 (추세 방향으로)
if doji and should_enter_trade()
    [profit_target, stop_loss] = calculate_targets()
    if uptrend
        strategy.entry("LONG_DOJI", strategy.long)
        strategy.exit("LONG_DOJI_EXIT", "LONG_DOJI", limit=close + profit_target, stop=close - stop_loss)
        
        if debug_mode
            label.delete(current_label)
            current_label := label.new(bar_index, low, "⚪ 도지(상승)", color=color.lime, textcolor=color.black, style=label.style_label_up)
    else if downtrend
        strategy.entry("SHORT_DOJI", strategy.short)
        strategy.exit("SHORT_DOJI_EXIT", "SHORT_DOJI", limit=close - profit_target, stop=close + stop_loss)
        
        if debug_mode
            label.delete(current_label)
            current_label := label.new(bar_index, high, "⚪ 도지(하락)", color=color.orange, textcolor=color.white, style=label.style_label_down)

// 5. 상승 추세 거래 (매우 간단한 조건)
if uptrend and close > open and should_enter_trade()
    [profit_target, stop_loss] = calculate_targets()
    strategy.entry("LONG_TREND", strategy.long)
    strategy.exit("LONG_TREND_EXIT", "LONG_TREND", limit=close + profit_target, stop=close - stop_loss)
    
    if debug_mode
        label.delete(current_label)
        current_label := label.new(bar_index, low, "📈 상승추세", color=color.purple, textcolor=color.white, style=label.style_label_up)

// 6. 하락 추세 거래 (매우 간단한 조건)
if downtrend and close < open and should_enter_trade()
    [profit_target, stop_loss] = calculate_targets()
    strategy.entry("SHORT_TREND", strategy.short)
    strategy.exit("SHORT_TREND_EXIT", "SHORT_TREND", limit=close - profit_target, stop=close + stop_loss)
    
    if debug_mode
        label.delete(current_label)
        current_label := label.new(bar_index, high, "📉 하락추세", color=color.maroon, textcolor=color.white, style=label.style_label_down)

// ============================================================================
// 디버깅 정보 표시
// ============================================================================

if debug_mode and barstate.islast
    var table debug_table = table.new(position.top_right, 2, 8, bgcolor=color.white, border_width=1)
    
    table.cell(debug_table, 0, 0, "패턴", text_color=color.black, bgcolor=color.gray)
    table.cell(debug_table, 1, 0, "감지", text_color=color.black, bgcolor=color.gray)
    
    table.cell(debug_table, 0, 1, "상승 엔걸핑", text_color=color.black)
    table.cell(debug_table, 1, 1, bull_engulfing ? "✅" : "❌", text_color=bull_engulfing ? color.green : color.red)
    
    table.cell(debug_table, 0, 2, "하락 엔걸핑", text_color=color.black)
    table.cell(debug_table, 1, 2, bear_engulfing ? "✅" : "❌", text_color=bear_engulfing ? color.green : color.red)
    
    table.cell(debug_table, 0, 3, "해머", text_color=color.black)
    table.cell(debug_table, 1, 3, hammer ? "✅" : "❌", text_color=hammer ? color.green : color.red)
    
    table.cell(debug_table, 0, 4, "도지", text_color=color.black)
    table.cell(debug_table, 1, 4, doji ? "✅" : "❌", text_color=doji ? color.green : color.red)
    
    table.cell(debug_table, 0, 5, "상승추세", text_color=color.black)
    table.cell(debug_table, 1, 5, uptrend ? "✅" : "❌", text_color=uptrend ? color.green : color.red)
    
    table.cell(debug_table, 0, 6, "하락추세", text_color=color.black)
    table.cell(debug_table, 1, 6, downtrend ? "✅" : "❌", text_color=downtrend ? color.green : color.red)
    
    table.cell(debug_table, 0, 7, "거래가능", text_color=color.black)
    table.cell(debug_table, 1, 7, should_enter_trade() ? "✅" : "❌", text_color=should_enter_trade() ? color.green : color.red)
