//@version=6
strategy("패턴 DB 기반 거래 전략", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=2)

// ============================================================================
// 설정
// ============================================================================

// 백테스트 기간
start_date = input.time(timestamp("2020-01-01 00:00"), "백테스트 시작일")
end_date = input.time(timestamp("2025-09-13 00:00"), "백테스트 종료일")

// 패턴 설정
pattern_length = input.int(20, "패턴 길이 (캔들 수)", minval=5, maxval=50)
min_similarity = input.float(0.8, "최소 유사도", minval=0.5, maxval=1.0)
min_confidence = input.float(0.7, "최소 신뢰도", minval=0.0, maxval=1.0)

// 거래 설정
profit_target_pct = input.float(0.01, "수익 목표 (%)", minval=0.001, maxval=0.1)
stop_loss_pct = input.float(0.02, "손절매 (%)", minval=0.005, maxval=0.1)

// 디버깅
show_patterns = input.bool(true, "패턴 표시")
show_similarity = input.bool(true, "유사도 표시")

// ============================================================================
// 패턴 데이터베이스 (성공한 패턴들)
// ============================================================================

// 성공한 패턴들을 벡터로 저장 (실제로는 더 많은 패턴이 필요)
var array<float> pattern_db_high = array.new<float>()
var array<float> pattern_db_low = array.new<float>()
var array<float> pattern_db_open = array.new<float>()
var array<float> pattern_db_close = array.new<float>()
var array<float> pattern_db_volume = array.new<float>()
var array<float> pattern_db_returns = array.new<float>()

// 패턴 DB 초기화 (실제로는 과거 데이터에서 추출)
init_pattern_db() =>
    // 예시: 상승 패턴들 (실제로는 백테스트에서 추출)
    // 패턴 1: 강한 상승 후 조정
    if array.size(pattern_db_high) == 0
        // 패턴 1
        for i = 0 to pattern_length - 1
            array.push(pattern_db_high, 100 + i * 0.5)
            array.push(pattern_db_low, 99 + i * 0.5)
            array.push(pattern_db_open, 99.5 + i * 0.5)
            array.push(pattern_db_close, 100 + i * 0.5)
            array.push(pattern_db_volume, 1000 + i * 100)
        array.push(pattern_db_returns, 0.05) // 5% 수익
        
        // 패턴 2: 엔걸핑 패턴
        for i = 0 to pattern_length - 1
            if i == pattern_length - 2
                array.push(pattern_db_high, 100 + i * 0.3)
                array.push(pattern_db_low, 99 + i * 0.3)
                array.push(pattern_db_open, 99.8 + i * 0.3)
                array.push(pattern_db_close, 99.2 + i * 0.3)
            else if i == pattern_length - 1
                array.push(pattern_db_high, 100.5 + i * 0.3)
                array.push(pattern_db_low, 99.2 + i * 0.3)
                array.push(pattern_db_open, 99.2 + i * 0.3)
                array.push(pattern_db_close, 100.3 + i * 0.3)
            else
                array.push(pattern_db_high, 100 + i * 0.3)
                array.push(pattern_db_low, 99.5 + i * 0.3)
                array.push(pattern_db_open, 99.7 + i * 0.3)
                array.push(pattern_db_close, 99.8 + i * 0.3)
            array.push(pattern_db_volume, 1000 + i * 50)
        array.push(pattern_db_returns, 0.08) // 8% 수익
        
        // 패턴 3: 해머 패턴
        for i = 0 to pattern_length - 1
            if i == pattern_length - 1
                array.push(pattern_db_high, 100 + i * 0.2)
                array.push(pattern_db_low, 98 + i * 0.2)
                array.push(pattern_db_open, 99.8 + i * 0.2)
                array.push(pattern_db_close, 99.9 + i * 0.2)
            else
                array.push(pattern_db_high, 100 + i * 0.2)
                array.push(pattern_db_low, 99.5 + i * 0.2)
                array.push(pattern_db_open, 99.7 + i * 0.2)
                array.push(pattern_db_close, 99.8 + i * 0.2)
            array.push(pattern_db_volume, 1000 + i * 80)
        array.push(pattern_db_returns, 0.06) // 6% 수익

// ============================================================================
// 패턴 벡터화 및 유사도 계산
// ============================================================================

// 현재 차트 데이터를 벡터로 변환
get_current_pattern() =>
    var array<float> current_high = array.new<float>()
    var array<float> current_low = array.new<float>()
    var array<float> current_open = array.new<float>()
    var array<float> current_close = array.new<float>()
    var array<float> current_volume = array.new<float>()
    
    // 최근 pattern_length개의 데이터 수집
    if barstate.isconfirmed
        array.clear(current_high)
        array.clear(current_low)
        array.clear(current_open)
        array.clear(current_close)
        array.clear(current_volume)
        
        for i = 0 to pattern_length - 1
            array.push(current_high, high[i])
            array.push(current_low, low[i])
            array.push(current_open, open[i])
            array.push(current_close, close[i])
            array.push(current_volume, volume[i])
    
    [current_high, current_low, current_open, current_close, current_volume]

// 코사인 유사도 계산
calculate_cosine_similarity(arr1, arr2) =>
    if array.size(arr1) != array.size(arr2)
        0.0
    else
        dot_product = 0.0
        norm1 = 0.0
        norm2 = 0.0
        
        for i = 0 to array.size(arr1) - 1
            val1 = array.get(arr1, i)
            val2 = array.get(arr2, i)
            dot_product += val1 * val2
            norm1 += val1 * val1
            norm2 += val2 * val2
        
        if norm1 > 0 and norm2 > 0
            dot_product / (math.sqrt(norm1) * math.sqrt(norm2))
        else
            0.0

// 패턴 유사도 계산
calculate_pattern_similarity() =>
    [curr_high, curr_low, curr_open, curr_close, curr_volume] = get_current_pattern()
    
    if array.size(curr_high) < pattern_length
        [0.0, 0.0, 0.0]
    else
        max_similarity = 0.0
        best_pattern_idx = 0
        best_return = 0.0
        
        // DB의 모든 패턴과 비교
        num_patterns = array.size(pattern_db_returns)
        for p = 0 to num_patterns - 1
            // 각 패턴의 시작 인덱스 계산
            start_idx = p * pattern_length
            
            // 현재 패턴과 DB 패턴 비교
            high_sim = calculate_cosine_similarity(curr_high, array.slice(pattern_db_high, start_idx, start_idx + pattern_length))
            low_sim = calculate_cosine_similarity(curr_low, array.slice(pattern_db_low, start_idx, start_idx + pattern_length))
            open_sim = calculate_cosine_similarity(curr_open, array.slice(pattern_db_open, start_idx, start_idx + pattern_length))
            close_sim = calculate_cosine_similarity(curr_close, array.slice(pattern_db_close, start_idx, start_idx + pattern_length))
            volume_sim = calculate_cosine_similarity(curr_volume, array.slice(pattern_db_volume, start_idx, start_idx + pattern_length))
            
            // 가중 평균 유사도 (OHLC에 더 높은 가중치)
            avg_similarity = (high_sim * 0.25 + low_sim * 0.25 + open_sim * 0.2 + close_sim * 0.2 + volume_sim * 0.1)
            
            if avg_similarity > max_similarity
                max_similarity := avg_similarity
                best_pattern_idx := p
                best_return := array.get(pattern_db_returns, p)
        
        [max_similarity, best_return, best_pattern_idx]

// ============================================================================
// 거래 실행
// ============================================================================

// 거래 조건
in_trading_time = time >= start_date and time <= end_date
no_position = strategy.position_size == 0

// 패턴 DB 초기화
init_pattern_db()

// 패턴 유사도 계산
[similarity, expected_return, pattern_idx] = calculate_pattern_similarity()

// 거래 신호
should_enter_long = similarity >= min_similarity and expected_return > 0 and in_trading_time and no_position
should_enter_short = similarity >= min_similarity and expected_return < 0 and in_trading_time and no_position

// 수익 목표 계산
calculate_targets() =>
    profit_target = close * profit_target_pct
    stop_loss = close * stop_loss_pct
    [profit_target, stop_loss]

// 거래 실행
if should_enter_long
    [profit_target, stop_loss] = calculate_targets()
    strategy.entry("LONG_PATTERN", strategy.long)
    strategy.exit("LONG_PATTERN_EXIT", "LONG_PATTERN", limit=close + profit_target, stop=close - stop_loss)
    
    if show_patterns
        label.new(bar_index, low, "🟢 패턴매수\n유사도: " + str.tostring(similarity, "#.##") + "\n예상수익: " + str.tostring(expected_return * 100, "#.#") + "%", 
                 color=color.green, textcolor=color.white, style=label.style_label_up)

if should_enter_short
    [profit_target, stop_loss] = calculate_targets()
    strategy.entry("SHORT_PATTERN", strategy.short)
    strategy.exit("SHORT_PATTERN_EXIT", "SHORT_PATTERN", limit=close - profit_target, stop=close + stop_loss)
    
    if show_patterns
        label.new(bar_index, high, "🔴 패턴매도\n유사도: " + str.tostring(similarity, "#.##") + "\n예상수익: " + str.tostring(expected_return * 100, "#.#") + "%", 
                 color=color.red, textcolor=color.white, style=label.style_label_down)

// ============================================================================
// 디버깅 정보
// ============================================================================

if show_similarity and barstate.isconfirmed
    var table debug_table = table.new(position.top_right, 2, 6, bgcolor=color.white, border_width=1)
    
    table.cell(debug_table, 0, 0, "패턴 정보", text_color=color.black, bgcolor=color.gray)
    table.cell(debug_table, 1, 0, "값", text_color=color.black, bgcolor=color.gray)
    
    table.cell(debug_table, 0, 1, "유사도", text_color=color.black)
    table.cell(debug_table, 1, 1, str.tostring(similarity, "#.##"), text_color=similarity >= min_similarity ? color.green : color.red)
    
    table.cell(debug_table, 0, 2, "예상수익", text_color=color.black)
    table.cell(debug_table, 1, 2, str.tostring(expected_return * 100, "#.#") + "%", text_color=expected_return > 0 ? color.green : color.red)
    
    table.cell(debug_table, 0, 3, "패턴번호", text_color=color.black)
    table.cell(debug_table, 1, 3, str.tostring(pattern_idx), text_color=color.black)
    
    table.cell(debug_table, 0, 4, "거래가능", text_color=color.black)
    table.cell(debug_table, 1, 4, (should_enter_long or should_enter_short) ? "✅" : "❌", text_color=(should_enter_long or should_enter_short) ? color.green : color.red)
    
    table.cell(debug_table, 0, 5, "포지션", text_color=color.black)
    table.cell(debug_table, 1, 5, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "NONE", text_color=color.black)
