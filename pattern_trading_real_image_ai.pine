        pattern10.pattern_quality := evaluate_pattern_quality(pattern10)
        array.push(image_pattern_db, pattern10)

// ============================================================================
// 실시간 이미지 분석 및 거래 신호
// ============================================================================

// 현재 차트를 이미지로 캡처
get_current_chart_image() =>
    capture_chart_image(0, pattern_candles - 1)

// 최적 패턴 찾기 (유사도 기반)
find_best_image_pattern() =>
    current_image = get_current_chart_image()
    best_similarity = 0.0
    best_pattern = null
    best_expected_return = 0.0
    best_pattern_quality = 0.0
    best_pattern_name = ""
    
    if current_image != ""
        for i = 0 to array.size(image_pattern_db) - 1
            pattern = array.get(image_pattern_db, i)
            
            // 이미지 유사도 계산 (진입 결정의 핵심)
            similarity = calculate_ai_image_similarity(current_image, pattern.image_data)
            
            // 패턴 품질 계산 (필터링용)
            pattern_quality = calculate_ai_pattern_quality(current_image, pattern.pattern_type)
            
            // 유사도가 높고 품질이 좋은 패턴 선택
            if similarity > best_similarity and similarity >= min_image_similarity and pattern_quality >= min_pattern_quality
                best_similarity := similarity
                best_pattern := pattern
                best_expected_return := pattern.expected_return
                best_pattern_quality := pattern_quality
                best_pattern_name := pattern.pattern_name
    
    [best_similarity, best_expected_return, best_pattern_quality, best_pattern_name]

// AI 기반 청산/손절 신호
generate_ai_exit_signal() =>
    if not enable_ai_exit
        [false, false]
    else
        // AI가 실시간으로 청산/손절 신호 생성
        // 실제 구현에서는 AI 모델 사용
        exit_long = false
        exit_short = false
        
        // 간단한 예시: 가격 변동성 기반
        if strategy.position_size > 0
            price_change = (close - strategy.position_avg_price) / strategy.position_avg_price
            exit_long := price_change >= profit_target_pct or price_change <= -stop_loss_pct
        
        if strategy.position_size < 0
            price_change = (strategy.position_avg_price - close) / strategy.position_avg_price
            exit_short := price_change >= profit_target_pct or price_change <= -stop_loss_pct
        
        [exit_long, exit_short]

// ============================================================================
// 메인 실행 로직
// ============================================================================

// 패턴 DB 초기화
init_image_patterns()

// 최적 패턴 찾기
[similarity, expected_return, pattern_quality, pattern_name] = find_best_image_pattern()

// 거래 조건
in_trading_time = time >= start_date and time <= end_date
no_position = strategy.position_size == 0

// 거래 신호 (유사도 기반)
should_enter_long = similarity >= min_image_similarity and expected_return > 0 and pattern_quality >= min_pattern_quality and in_trading_time and no_position
should_enter_short = similarity >= min_image_similarity and expected_return < 0 and pattern_quality >= min_pattern_quality and in_trading_time and no_position

// 패턴별 동적 수익 목표 계산
calculate_pattern_profit_target(pattern) =>
    if pattern == null
        [0.0, 0.0]
    else
        // 패턴의 실제 성공한 거래들의 평균 수익률 사용
        avg_profit = math.abs(pattern.expected_return)
        
        // 성공률에 따라 수익 목표 조정 (성공률이 높을수록 더 보수적)
        if pattern.success_rate >= 0.8
            profit_target = avg_profit * 0.7  // 80% 이상 성공률이면 70%만 목표
        else if pattern.success_rate >= 0.7
            profit_target = avg_profit * 0.8  // 70% 이상 성공률이면 80% 목표
        else
            profit_target = avg_profit * 0.9  // 70% 미만이면 90% 목표
        
        // 손절매는 수익 목표의 50%로 설정
        stop_loss = profit_target * 0.5
        
        [profit_target, stop_loss]

// AI 청산/손절 신호
[exit_long, exit_short] = generate_ai_exit_signal()

// 거래 실행 (패턴별 동적 수익 목표)
if should_enter_long
    // 현재 패턴 찾기
    current_pattern = null
    for i = 0 to array.size(image_pattern_db) - 1
        pattern = array.get(image_pattern_db, i)
        if pattern.pattern_name == pattern_name
            current_pattern := pattern
            break
    
    // 패턴별 동적 수익 목표 계산
    [profit_target, stop_loss] = calculate_pattern_profit_target(current_pattern)
    
    strategy.entry("LONG_IMAGE_AI", strategy.long)
    strategy.exit("LONG_IMAGE_AI_EXIT", "LONG_IMAGE_AI", limit=close * (1 + profit_target), stop=close * (1 - stop_loss))
    
    if show_pattern_images
        label.new(bar_index, low, "🟢 " + pattern_name + "\n유사도: " + str.tostring(similarity, "#.##") + "\n수익목표: " + str.tostring(profit_target * 100, "#.#") + "%\n손절매: " + str.tostring(stop_loss * 100, "#.#") + "%", 
                 color=color.green, textcolor=color.white, style=label.style_label_up)

if should_enter_short
    // 현재 패턴 찾기
    current_pattern = null
    for i = 0 to array.size(image_pattern_db) - 1
        pattern = array.get(image_pattern_db, i)
        if pattern.pattern_name == pattern_name
            current_pattern := pattern
            break
    
    // 패턴별 동적 수익 목표 계산
    [profit_target, stop_loss] = calculate_pattern_profit_target(current_pattern)
    
    strategy.entry("SHORT_IMAGE_AI", strategy.short)
    strategy.exit("SHORT_IMAGE_AI_EXIT", "SHORT_IMAGE_AI", limit=close * (1 - profit_target), stop=close * (1 + stop_loss))
    
    if show_pattern_images
        label.new(bar_index, high, "🔴 " + pattern_name + "\n유사도: " + str.tostring(similarity, "#.##") + "\n수익목표: " + str.tostring(profit_target * 100, "#.#") + "%\n손절매: " + str.tostring(stop_loss * 100, "#.#") + "%", 
                 color=color.red, textcolor=color.white, style=label.style_label_down)

// AI 청산/손절 실행
if exit_long and strategy.position_size > 0
    strategy.close("LONG_IMAGE_AI", comment="AI 청산")

if exit_short and strategy.position_size < 0
    strategy.close("SHORT_IMAGE_AI", comment="AI 손절")

// ============================================================================
// 시각화 및 디버깅
// ============================================================================

// AI 분석 결과 표시
if show_ai_analysis and barstate.isconfirmed
    var table ai_table = table.new(position.top_right, 3, 7, bgcolor=color.white, border_width=1)
    
    table.cell(ai_table, 0, 0, "AI 분석", text_color=color.black, bgcolor=color.gray)
    table.cell(ai_table, 1, 0, "값", text_color=color.black, bgcolor=color.gray)
    table.cell(ai_table, 2, 0, "상태", text_color=color.black, bgcolor=color.gray)
    
    table.cell(ai_table, 0, 1, "이미지 유사도", text_color=color.black)
    table.cell(ai_table, 1, 1, str.tostring(similarity, "#.##"), text_color=color.black)
    table.cell(ai_table, 2, 1, similarity >= min_image_similarity ? "✅" : "❌", text_color=color.black)
    
    table.cell(ai_table, 0, 2, "패턴 품질", text_color=color.black)
    table.cell(ai_table, 1, 2, str.tostring(pattern_quality, "#.##"), text_color=color.black)
    table.cell(ai_table, 2, 2, pattern_quality >= min_pattern_quality ? "✅" : "❌", text_color=color.black)
    
    table.cell(ai_table, 0, 3, "예상 수익률", text_color=color.black)
    table.cell(ai_table, 1, 3, str.tostring(expected_return * 100, "#.#") + "%", text_color=color.black)
    table.cell(ai_table, 2, 3, expected_return > 0 ? "📈" : "📉", text_color=color.black)
    
    table.cell(ai_table, 0, 4, "패턴 이름", text_color=color.black)
    table.cell(ai_table, 1, 4, pattern_name, text_color=color.black)
    table.cell(ai_table, 2, 4, pattern_name != "" ? "🎯" : "⏳", text_color=color.black)
    
    table.cell(ai_table, 0, 5, "거래 신호", text_color=color.black)
    signal_text = should_enter_long ? "🟢 LONG" : should_enter_short ? "🔴 SHORT" : "⏸️ 대기"
    table.cell(ai_table, 1, 5, signal_text, text_color=color.black)
    table.cell(ai_table, 2, 5, (should_enter_long or should_enter_short) ? "🚀" : "⏳", text_color=color.black)
    
    // 패턴 통계 정보 추가
    if pattern_name != ""
        for i = 0 to array.size(image_pattern_db) - 1
            pattern = array.get(image_pattern_db, i)
            if pattern.pattern_name == pattern_name
                table.cell(ai_table, 0, 6, "패턴 통계", text_color=color.black)
                stats_text = "출현:" + str.tostring(pattern.total_occurrences) + " 성공:" + str.tostring(pattern.success_count) + " 실패:" + str.tostring(pattern.failure_count)
                table.cell(ai_table, 1, 6, stats_text, text_color=color.black)
                table.cell(ai_table, 2, 6, "📊", text_color=color.black)
                break

// 미래 예상 흐름 표시
if show_future_projection and similarity >= min_image_similarity and barstate.isconfirmed
    // 예상 상승 경로
    if expected_return > 0
        future_price = close * (1 + expected_return)
        line.new(bar_index, close, bar_index + 20, future_price, color=color.yellow, width=2, style=line.style_dashed)
        label.new(bar_index + 20, future_price, "AI 예상: " + str.tostring(expected_return * 100, "#.#") + "%", 
                 color=color.yellow, textcolor=color.black, style=label.style_label_left)
    
    // 예상 하락 경로
    if expected_return < 0
        future_price = close * (1 + expected_return)
        line.new(bar_index, close, bar_index + 20, future_price, color=color.orange, width=2, style=line.style_dashed)
        label.new(bar_index + 20, future_price, "AI 예상: " + str.tostring(expected_return * 100, "#.#") + "%", 
                 color=color.orange, textcolor=color.black, style=label.style_label_left)
