//@version=6
//+------------------------------------------------------------------+
//|                                          UT Bot v6 - Pine Script |
//|                        Copyright 2024, TradingView Community     |
//|                                             https://www.tradingview.com |
//+------------------------------------------------------------------+
//| UT Bot 지표 - ATR 기반 트레일링 스탑과 이동평균 교차를 이용한 매매 신호 생성 |
//|                                                                  |
//| 핵심 원리:                                                       |
//| 1. ATR(평균 진폭 범위)을 계산하여 시장 변동성 측정                |
//| 2. ATR 기반 트레일링 스탑 라인을 동적으로 계산                   |
//| 3. EMA(지수이동평균) 1기간과 ATR 스탑 라인의 교차를 감지          |
//| 4. 가격이 ATR 스탑 위/아래에 있으면서 교차가 발생할 때 신호 생성  |
//+------------------------------------------------------------------+

indicator(title = 'UT Bot Alerts', overlay = true) 

//+------------------------------------------------------------------+
//| 입력 파라미터 설정                                               |
//+------------------------------------------------------------------+
a = input(1, title = 'Key Value. \'This changes the sensitivity\'')  // 민감도 조절 값 (낮을수록 더 많은 신호)
c = input(10, title = 'ATR Period')                                   // ATR 계산 기간 (일반적으로 10-20 사용)
h = input(false, title = 'Signals from Heikin Ashi Candles')         // 하이킨아시 캔들 사용 여부

//+------------------------------------------------------------------+
//| ATR(평균 진폭 범위) 계산                                         |
//+------------------------------------------------------------------+
// ATR은 시장의 변동성을 측정하는 지표입니다
// 높은 ATR = 변동성이 큰 시장, 낮은 ATR = 변동성이 작은 시장
xATR = ta.atr(c)        // 지정된 기간(c) 동안의 ATR 값 계산
nLoss = a * xATR        // 손실 허용 범위 = 민감도 × ATR (이 값이 트레일링 스탑의 폭을 결정)

//+------------------------------------------------------------------+
//| 가격 데이터 선택 (일반 캔들 vs 하이킨아시 캔들)                  |
//+------------------------------------------------------------------+
// 하이킨아시 캔들은 노이즈를 줄여주지만 지연이 있을 수 있습니다
// 일반 캔들: 실시간 반응, 하이킨아시: 부드러운 신호
src = h ? request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, close, lookahead = barmerge.lookahead_off) : close

//+------------------------------------------------------------------+
//| ATR 기반 트레일링 스탑 라인 계산 (핵심 로직)                    |
//+------------------------------------------------------------------+
// 이 부분이 UT Bot의 핵심입니다. 가격 움직임에 따라 동적으로 스탑 라인을 조정합니다
xATRTrailingStop = 0.0  // ATR 트레일링 스탑 초기값

// 1단계: 기본 스탑 라인 계산
// 현재 가격이 이전 스탑보다 높으면: 가격 - 손실허용범위 (상승 추세)
// 현재 가격이 이전 스탑보다 낮으면: 가격 + 손실허용범위 (하락 추세)
iff_1 = src > nz(xATRTrailingStop[1], 0) ? src - nLoss : src + nLoss

// 2단계: 하락 추세에서 스탑 라인 조정
// 가격이 계속 하락하고 있으면: 이전 스탑과 새로 계산된 스탑 중 더 높은 값 선택
// (스탑 라인이 너무 빨리 내려가지 않도록 보호)
iff_2 = src < nz(xATRTrailingStop[1], 0) and src[1] < nz(xATRTrailingStop[1], 0) ? math.min(nz(xATRTrailingStop[1]), src + nLoss) : iff_1

// 3단계: 상승 추세에서 스탑 라인 조정
// 가격이 계속 상승하고 있으면: 이전 스탑과 새로 계산된 스탑 중 더 낮은 값 선택
// (스탑 라인이 너무 빨리 올라가지 않도록 보호)
xATRTrailingStop := src > nz(xATRTrailingStop[1], 0) and src[1] > nz(xATRTrailingStop[1], 0) ? math.max(nz(xATRTrailingStop[1]), src - nLoss) : iff_2

//+------------------------------------------------------------------+
//| 포지션 상태 추적 (참고용)                                        |
//+------------------------------------------------------------------+
// 현재 포지션이 매수인지 매도인지 추적 (신호 생성에는 직접 사용되지 않음)
pos = 0
iff_3 = src[1] > nz(xATRTrailingStop[1], 0) and src < nz(xATRTrailingStop[1], 0) ? -1 : nz(pos[1], 0)  // 매도 포지션
pos := src[1] < nz(xATRTrailingStop[1], 0) and src > nz(xATRTrailingStop[1], 0) ? 1 : iff_3              // 매수 포지션

// 포지션에 따른 색상 설정 (차트 시각화용)
xcolor = pos == -1 ? color.red : pos == 1 ? color.green : color.blue

//+------------------------------------------------------------------+
//| 이동평균 계산 및 교차 감지 (신호 생성의 핵심)                    |
//+------------------------------------------------------------------+
// EMA 1기간 = 현재 가격과 거의 동일하지만 약간의 스무딩 효과가 있음
ema = ta.ema(src, 1)  // 1기간 지수이동평균 (현재 가격과 거의 동일)

// 교차 감지 함수들
// ta.crossover(a, b): a가 b를 위로 교차할 때 true 반환
above = ta.crossover(ema, xATRTrailingStop)  // EMA가 ATR 스탑 라인을 위로 교차
below = ta.crossover(xATRTrailingStop, ema)  // ATR 스탑 라인이 EMA를 위로 교차

//+------------------------------------------------------------------+
//| 매매 신호 생성 (최종 로직)                                       |
//+------------------------------------------------------------------+
// 신호 생성 조건:
// 1. 가격이 ATR 스탑 라인 위/아래에 있어야 함
// 2. 동시에 교차가 발생해야 함
// 이 두 조건을 모두 만족할 때만 신호가 발생합니다

buy = src > xATRTrailingStop and above   // 매수 신호: 가격 > 스탑 라인 AND EMA가 스탑을 위로 교차
sell = src < xATRTrailingStop and below  // 매도 신호: 가격 < 스탑 라인 AND 스탑이 EMA를 위로 교차

//+------------------------------------------------------------------+
//| 차트 색상 표시 (참고용)                                          |
//+------------------------------------------------------------------+
// 현재 가격이 ATR 스탑 라인 위/아래에 있는지에 따라 캔들 색상 변경
barbuy = src > xATRTrailingStop   // 가격이 스탑 라인 위에 있음 (상승 추세)
barsell = src < xATRTrailingStop  // 가격이 스탑 라인 아래에 있음 (하락 추세)

//+------------------------------------------------------------------+
//| 차트에 신호 표시                                                 |
//+------------------------------------------------------------------+
// 매수 신호: 녹색 위쪽 화살표를 캔들 아래에 표시
plotshape(buy, title = 'Buy', text = 'Buy', style = shape.labelup, location = location.belowbar, color = color.new(color.green, 0), textcolor = color.new(color.white, 0), size = size.tiny)

// 매도 신호: 빨간색 아래쪽 화살표를 캔들 위에 표시
plotshape(sell, title = 'Sell', text = 'Sell', style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0), textcolor = color.new(color.white, 0), size = size.tiny)

//+------------------------------------------------------------------+
//| 캔들 색상 변경                                                   |
//+------------------------------------------------------------------+
// 현재 추세에 따라 캔들 색상 변경 (시각적 참고용)
barcolor(barbuy ? color.green : na)   // 상승 추세: 녹색 캔들
barcolor(barsell ? color.red : na)    // 하락 추세: 빨간색 캔들

//+------------------------------------------------------------------+
//| 알림 설정                                                       |
//+------------------------------------------------------------------+
// 신호 발생 시 알림을 보내도록 설정 (자동매매 시스템 연동용)
alertcondition(buy, 'UT Long', 'UT Long')    // 매수 신호 알림
alertcondition(sell, 'UT Short', 'UT Short') // 매도 신호 알림
