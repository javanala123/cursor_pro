//@version=6
strategy("하이브리드 AI 패턴 거래 시스템", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=2)

// ============================================================================
// 설정
// ============================================================================

// 백테스트 기간
start_date = input.time(timestamp("2020-01-01 00:00"), "백테스트 시작일")
end_date = input.time(timestamp("2025-09-13 00:00"), "백테스트 종료일")

// 하이브리드 분석 설정
pattern_candles = input.int(150, "패턴 캔들 수", minval=100, maxval=300)
curve_similarity_threshold = input.float(0.50, "1차 곡선 유사도 임계값", minval=0.30, maxval=0.90)
image_similarity_threshold = input.float(0.50, "2차 이미지 유사도 임계값", minval=0.30, maxval=0.95)
min_pattern_quality = input.float(0.50, "최소 패턴 품질", minval=0.30, maxval=0.95)

// 시각화 설정
show_curve_analysis = input.bool(true, "곡선 분석 표시")
show_image_analysis = input.bool(true, "이미지 분석 표시")
show_hybrid_results = input.bool(true, "하이브리드 결과 표시")

// ============================================================================
// 하이브리드 패턴 데이터베이스
// ============================================================================

// 곡선 + 이미지 패턴 구조
type HybridPattern
    // 곡선 데이터
    array<float> curve_points      // 중심선 곡선 좌표
    array<float> curve_features    // 곡선 특징 (기울기, 변곡점 등)
    
    // 이미지 데이터
    string image_data              // Base64 인코딩된 이미지
    array<float> image_features    // 이미지 특징 벡터
    
    // 통계 데이터
    float expected_return          // 예상 수익률
    int total_occurrences          // 총 출현횟수
    int success_count              // 성공횟수
    int failure_count              // 실패횟수
    float success_rate             // 실제 성공률
    float pattern_quality          // 패턴 품질 점수
    string pattern_name            // 패턴 이름
    int pattern_type               // 1: 상승, -1: 하락, 0: 중립

// 패턴 DB 초기화
var array<HybridPattern> hybrid_pattern_db = array.new<HybridPattern>()

// ============================================================================
// 1단계: 곡선 분석 함수들
// ============================================================================

// 중심선 곡선 추출
extract_center_curve(start_bar, end_bar) =>
    curve_points = array.new<float>()
    
    // barstate.isconfirmed 조건 제거 - 항상 실행
    for i = start_bar to end_bar
        if i >= 0 and i < bar_index
            // 중심선 계산 (OHLC 평균)
            center_price = (high[i] + low[i] + open[i] + close[i]) / 4
            array.push(curve_points, center_price)
    
    curve_points

// 곡선 특징 추출
extract_curve_features(curve_points) =>
    var array<float> features = array.new<float>()
    
    if array.size(curve_points) > 0
        array.clear(features)
        
        // 1. 전체 기울기 (시작-끝)
        start_price = array.get(curve_points, 0)
        end_price = array.get(curve_points, array.size(curve_points) - 1)
        total_slope = (end_price - start_price) / start_price
        array.push(features, total_slope)
        
        // 2. 평균 기울기 (5개 구간)
        for i = 0 to 4
            start_idx = i * math.floor(array.size(curve_points) / 5)
            end_idx = math.min((i + 1) * math.floor(array.size(curve_points) / 5) - 1, array.size(curve_points) - 1)
            if start_idx < end_idx
                segment_slope = (array.get(curve_points, end_idx) - array.get(curve_points, start_idx)) / array.get(curve_points, start_idx)
                array.push(features, segment_slope)
        
        // 3. 변곡점 개수
        inflection_count = 0.0
        for i = 1 to array.size(curve_points) - 2
            prev_slope = array.get(curve_points, i) - array.get(curve_points, i - 1)
            next_slope = array.get(curve_points, i + 1) - array.get(curve_points, i)
            if (prev_slope > 0 and next_slope < 0) or (prev_slope < 0 and next_slope > 0)
                inflection_count += 1
        array.push(features, inflection_count)
        
        // 4. 변동성 (표준편차)
        mean_price = array.avg(curve_points)
        variance = 0.0
        for i = 0 to array.size(curve_points) - 1
            price = array.get(curve_points, i)
            variance += math.pow(price - mean_price, 2)
        volatility = math.sqrt(variance / array.size(curve_points))
        array.push(features, volatility)
        
        // 5. 최고점/최저점 비율
        max_price = array.max(curve_points)
        min_price = array.min(curve_points)
        range_ratio = (max_price - min_price) / min_price
        array.push(features, range_ratio)
    
    features

// DTW (Dynamic Time Warping) 거리 계산
calculate_dtw_distance(curve1, curve2) =>
    if array.size(curve1) == 0 or array.size(curve2) == 0
        999999.0
    else
        // 간소화된 DTW 구현
        len1 = array.size(curve1)
        len2 = array.size(curve2)
        
        // 정규화
        norm1 = array.avg(curve1)
        norm2 = array.avg(curve2)
        
        if norm1 == 0 or norm2 == 0
            999999.0
        else
            // 정규화된 곡선
            normalized1 = array.new<float>()
            normalized2 = array.new<float>()
            
            for i = 0 to len1 - 1
                array.push(normalized1, array.get(curve1, i) / norm1)
            
            for i = 0 to len2 - 1
                array.push(normalized2, array.get(curve2, i) / norm2)
            
            // DTW 거리 계산 (간소화)
            total_distance = 0.0
            min_len = math.min(len1, len2)
            
            for i = 0 to min_len - 1
                val1 = array.get(normalized1, i)
                val2 = array.get(normalized2, i)
                total_distance += math.pow(val1 - val2, 2)
            
            math.sqrt(total_distance / min_len)

// 곡선 유사도 계산
calculate_curve_similarity(curve1, curve2) =>
    dtw_distance = calculate_dtw_distance(curve1, curve2)
    if dtw_distance > 10.0  // 임계값
        0.0
    else
        1.0 / (1.0 + dtw_distance)

// ============================================================================
// 2단계: 이미지 분석 함수들
// ============================================================================

// 차트를 이미지로 캡처
capture_chart_image(start_bar, end_bar) =>
    chart_image = ""
    
    // barstate.isconfirmed 조건 제거 - 항상 실행
    image_pixels = array.new<string>()
    
    for i = start_bar to end_bar
        if i >= 0 and i < bar_index
            // 캔들스틱을 픽셀로 변환 (간소화)
            x = i - start_bar
            y_high = math.round((high[i] - low[i]) * 100)
            y_low = math.round((low[i] - low[i]) * 100)
            y_open = math.round((open[i] - low[i]) * 100)
            y_close = math.round((close[i] - low[i]) * 100)
            
            pixel_data = str.tostring(x) + "," + str.tostring(y_high) + "," + str.tostring(y_low) + "," + str.tostring(y_open) + "," + str.tostring(y_close)
            array.push(image_pixels, pixel_data)
    
    // 간소화된 이미지 데이터 생성
    chart_image := "image_data_" + str.tostring(bar_index) + "_" + str.tostring(array.size(image_pixels))
    
    chart_image

// 이미지 특징 추출
extract_image_features(image_data) =>
    var array<float> features = array.new<float>()
    
    if image_data != ""
        // 간소화된 이미지 특징 추출
        array.clear(features)
        
        // 1. 색상 분포 (상승/하락 캔들 비율)
        bullish_ratio = 0.0
        bearish_ratio = 0.0
        
        // 2. 모양 특징 (해머, 도지 등)
        hammer_score = 0.0
        doji_score = 0.0
        
        // 3. 추세 특징
        uptrend_strength = 0.0
        downtrend_strength = 0.0
        
        // 실제 구현에서는 이미지 픽셀 분석
        array.push(features, bullish_ratio)
        array.push(features, bearish_ratio)
        array.push(features, hammer_score)
        array.push(features, doji_score)
        array.push(features, uptrend_strength)
        array.push(features, downtrend_strength)
    
    features

// 이미지 유사도 계산
calculate_image_similarity(image1, image2) =>
    if image1 == "" or image2 == ""
        0.0
    else
        // 간소화된 이미지 유사도 계산
        features1 = extract_image_features(image1)
        features2 = extract_image_features(image2)
        
        if array.size(features1) != array.size(features2) or array.size(features1) == 0
            0.0
        else
            // 기본 유사도 계산 (간소화)
            base_similarity = 0.0
            
            // 이미지 데이터 길이 비교 (간소화)
            len1 = 10  // 기본 길이
            len2 = 10  // 기본 길이
            if image1 != "" and image2 != ""
                length_ratio = 1.0  // 동일한 길이로 가정
                base_similarity := length_ratio * 0.8  // 기본 80% 유사도
            
            // 특징 벡터 유사도 추가
            dot_product = 0.0
            norm1_sq = 0.0
            norm2_sq = 0.0
            
            for i = 0 to array.size(features1) - 1
                val1 = array.get(features1, i)
                val2 = array.get(features2, i)
                dot_product += val1 * val2
                norm1_sq += val1 * val1
                norm2_sq += val2 * val2
            
            feature_similarity = 0.0
            if norm1_sq > 0 and norm2_sq > 0
                feature_similarity := dot_product / (math.sqrt(norm1_sq) * math.sqrt(norm2_sq))
            
            // 종합 유사도 (기본 + 특징)
            math.max(base_similarity, feature_similarity)

// ============================================================================
// 패턴 품질 평가
// ============================================================================

// 패턴 품질 종합 평가
evaluate_pattern_quality(pattern) =>
    if pattern.total_occurrences < 10
        0.0
    else
        // 1. 성공률 기반 점수
        success_score = pattern.success_rate
        
        // 2. 출현횟수 기반 점수
        frequency_score = math.min(1.0, pattern.total_occurrences / 100.0)
        
        // 3. 패턴 강도 점수
        strength_score = math.min(1.0, math.abs(pattern.expected_return) / 0.2)
        
        // 4. 일관성 점수
        consistency_score = 1.0 - math.abs(pattern.success_rate - 0.5) * 2
        
        // 종합 점수
        total_score = (success_score * 0.4 + frequency_score * 0.3 + strength_score * 0.2 + consistency_score * 0.1)
        math.max(0.0, math.min(1.0, total_score))

// ============================================================================
// 패턴 데이터베이스 초기화
// ============================================================================

// 실제 성공 패턴 추출 함수
extract_successful_patterns() =>
    var array<HybridPattern> successful_patterns = array.new<HybridPattern>()
    
    // 5년 과거 데이터에서 성공한 반전 패턴들 추출
    lookback_years = 5
    min_profit_pips = 50  // 최소 50 pips 수익
    max_patterns = 100    // 최대 100개 패턴
    
    if array.size(successful_patterns) == 0
        // 실제 차트 데이터에서 패턴 추출
        for i = 150 to bar_index - 150
            // 반전 시점 감지 (저점)
            is_low_reversal = low[i] < low[i-1] and low[i] < low[i+1] and low[i] < low[i-2] and low[i] < low[i+2]
            
            if is_low_reversal
                // 반전 후 50캔들 동안 수익 확인
                entry_price = close[i]
                max_profit = 0.0
                
                for j = 1 to 50
                    if i + j < bar_index
                        profit = (high[i + j] - entry_price) / entry_price
                        max_profit := math.max(max_profit, profit)
                
                // 50 pips 이상 수익이면 성공 패턴으로 저장
                if max_profit >= min_profit_pips / 10000  // pips를 퍼센트로 변환
                    pattern = HybridPattern.new()
                    
                    // 실제 OHLC 데이터로 패턴 추출
                    pattern.curve_points := array.new<float>()
                    for k = -75 to 75
                        if i + k >= 0 and i + k < bar_index
                            center_price = (high[i + k] + low[i + k] + open[i + k] + close[i + k]) / 4
                            array.push(pattern.curve_points, center_price)
                    
                    pattern.curve_features := extract_curve_features(pattern.curve_points)
                    pattern.image_data := "real_pattern_" + str.tostring(i)
                    pattern.image_features := extract_image_features(pattern.image_data)
                    pattern.expected_return := max_profit
                    pattern.total_occurrences := 1
                    pattern.success_count := 1
                    pattern.failure_count := 0
                    pattern.success_rate := 1.0
                    pattern.pattern_quality := 0.0
                    pattern.pattern_name := "실제 상승 반전 " + str.tostring(i)
                    pattern.pattern_type := 1
                    pattern.pattern_quality := evaluate_pattern_quality(pattern)
                    array.push(successful_patterns, pattern)
                    
                    if array.size(successful_patterns) >= max_patterns
                        break
    
    // 패턴 2: 엔걸핑 상승 (하드코딩된 샘플 데이터)
    pattern2 = HybridPattern.new()
        pattern2.curve_points := array.new<float>()
        for i = 0 to 149
            array.push(pattern2.curve_points, 100.0 + i * 0.05)  // 완만한 상승 곡선 샘플
        
        pattern2.curve_features := extract_curve_features(pattern2.curve_points)
        pattern2.image_data := "sample_pattern_2"
        pattern2.image_features := extract_image_features(pattern2.image_data)
        pattern2.expected_return := 0.12
        pattern2.total_occurrences := 67
        pattern2.success_count := 52
        pattern2.failure_count := 15
        pattern2.success_rate := 0.776
        pattern2.pattern_quality := 0.0
        pattern2.pattern_name := "엔걸핑 상승"
        pattern2.pattern_type := 1
        pattern2.pattern_quality := evaluate_pattern_quality(pattern2)
        array.push(hybrid_pattern_db, pattern2)
        
        // 패턴 3: 해머 반전 (하드코딩된 샘플 데이터)
    pattern3 = HybridPattern.new()
        pattern3.curve_points := array.new<float>()
        for i = 0 to 149
            array.push(pattern3.curve_points, 100.0 + math.sin(i * 0.1) * 2)  // 변동 곡선 샘플
        
        pattern3.curve_features := extract_curve_features(pattern3.curve_points)
        pattern3.image_data := "sample_pattern_3"
        pattern3.image_features := extract_image_features(pattern3.image_data)
        pattern3.expected_return := 0.10
        pattern3.total_occurrences := 89
        pattern3.success_count := 64
        pattern3.failure_count := 25
        pattern3.success_rate := 0.719
        pattern3.pattern_quality := 0.0
        pattern3.pattern_name := "해머 반전"
        pattern3.pattern_type := 1
        pattern3.pattern_quality := evaluate_pattern_quality(pattern3)
        array.push(hybrid_pattern_db, pattern3)
        
        // 패턴 4: 더블 바텀 (하드코딩된 샘플 데이터)
    pattern4 = HybridPattern.new()
        pattern4.curve_points := array.new<float>()
        for i = 0 to 149
            array.push(pattern4.curve_points, 100.0 + math.cos(i * 0.1) * 3)  // U자 곡선 샘플
        
        pattern4.curve_features := extract_curve_features(pattern4.curve_points)
        pattern4.image_data := "sample_pattern_4"
        pattern4.image_features := extract_image_features(pattern4.image_data)
        pattern4.expected_return := 0.18
        pattern4.total_occurrences := 23
        pattern4.success_count := 20
        pattern4.failure_count := 3
        pattern4.success_rate := 0.870
        pattern4.pattern_quality := 0.0
        pattern4.pattern_name := "더블 바텀"
        pattern4.pattern_type := 1
        pattern4.pattern_quality := evaluate_pattern_quality(pattern4)
        array.push(hybrid_pattern_db, pattern4)
        
        // 패턴 5: 상승 추세 (하드코딩된 샘플 데이터)
    pattern5 = HybridPattern.new()
        pattern5.curve_points := array.new<float>()
        for i = 0 to 149
            array.push(pattern5.curve_points, 100.0 + i * 0.2)  // 강한 상승 곡선 샘플
        
        pattern5.curve_features := extract_curve_features(pattern5.curve_points)
        pattern5.image_data := "sample_pattern_5"
        pattern5.image_features := extract_image_features(pattern5.image_data)
        pattern5.expected_return := 0.20
        pattern5.total_occurrences := 34
        pattern5.success_count := 29
        pattern5.failure_count := 5
        pattern5.success_rate := 0.853
        pattern5.pattern_quality := 0.0
        pattern5.pattern_name := "상승 추세"
        pattern5.pattern_type := 1
        pattern5.pattern_quality := evaluate_pattern_quality(pattern5)
        array.push(hybrid_pattern_db, pattern5)

// ============================================================================
// AI 기반 패턴 품질 계산
// ============================================================================

// AI 기반 패턴 품질 계산
calculate_ai_pattern_quality(image_data, pattern_type) =>
    if image_data == ""
        0.0
    else
        // 실제 품질 계산 (간소화)
        base_quality = 0.85
        
        // 이미지 데이터 길이에 따른 품질 조정 (간소화)
        if image_data != ""
            base_quality := 0.90  // 기본 높은 품질
        else
            base_quality := 0.70
        
        base_quality

// ============================================================================
// 하이브리드 패턴 매칭
// ============================================================================

// 1단계: 곡선 기반 후보 선별 (실제 패턴 사용)
find_curve_candidates() =>
    current_curve = extract_center_curve(0, pattern_candles - 1)
    candidates = array.new<HybridPattern>()
    
    // 실제 성공 패턴들과 비교
    for i = 0 to array.size(successful_patterns) - 1
        pattern = array.get(successful_patterns, i)
        curve_similarity = calculate_curve_similarity(current_curve, pattern.curve_points)
        
        if curve_similarity >= curve_similarity_threshold
            array.push(candidates, pattern)
    
    candidates

// 2단계: 이미지 기반 정밀 매칭
find_best_hybrid_pattern() =>
    candidates = find_curve_candidates()
    best_similarity = 0.0
    var HybridPattern best_pattern = na
    best_expected_return = 0.0
    best_pattern_quality = 0.0
    best_pattern_name = ""
    
    if array.size(candidates) > 0
        current_image = capture_chart_image(0, pattern_candles - 1)
        
        for i = 0 to array.size(candidates) - 1
            pattern = array.get(candidates, i)
            
            // 이미지 유사도 계산
            image_similarity = calculate_image_similarity(current_image, pattern.image_data)
            
            // 패턴 품질 계산
            pattern_quality = calculate_ai_pattern_quality(current_image, pattern.pattern_type)
            
            // 종합 점수 (이미지 유사도 + 패턴 품질)
            total_score = (image_similarity * 0.7 + pattern_quality * 0.3)
            
            if total_score > best_similarity and total_score >= image_similarity_threshold and pattern.pattern_quality >= min_pattern_quality
                best_similarity := total_score
                best_pattern := pattern
                best_expected_return := pattern.expected_return
                best_pattern_quality := pattern_quality
                best_pattern_name := pattern.pattern_name
    
    [best_similarity, best_expected_return, best_pattern_quality, best_pattern_name]

// ============================================================================
// 메인 실행 로직
// ============================================================================

// 실제 성공 패턴 추출
successful_patterns = extract_successful_patterns()

// 하이브리드 패턴 매칭 (실제 패턴 사용)
[similarity, expected_return, pattern_quality, pattern_name] = find_best_hybrid_pattern()

// 거래 조건
in_trading_time = time >= start_date and time <= end_date
no_position = strategy.position_size == 0

// AI 기반 실시간 차트 감시 및 반전 감지
ai_realtime_analysis() =>
    // AI가 실시간 차트를 분석하여 반전 시점 감지
    var bool ai_detected_high_reversal = false
    var bool ai_detected_low_reversal = false
    var float ai_confidence = 0.0
    var string ai_analysis_result = ""
    
    // AI가 현재 차트 상태를 분석
    current_price = close
    price_momentum = (close - close[5]) / close[5]  // 5캔들 모멘텀
    volatility = ta.atr(14) / close  // 변동성
    
    // AI 기반 반전 감지 로직
    // 1. 가격 모멘텀 분석
    momentum_reversal = math.abs(price_momentum) > 0.02  // 2% 이상 모멘텀
    
    // 2. 변동성 분석
    volatility_spike = volatility > ta.sma(volatility, 20) * 1.5  // 변동성 급증
    
    // 3. 패턴 기반 반전 감지
    pattern_reversal = false
    if array.size(successful_patterns) > 0
        // 현재 150캔들 패턴 추출
        current_pattern = extract_center_curve(-75, 75)
        
        // AI가 성공 패턴들과 비교
        best_match_score = 0.0
        for i = 0 to array.size(successful_patterns) - 1
            pattern = array.get(successful_patterns, i)
            similarity = calculate_curve_similarity(current_pattern, pattern.curve_points)
            if similarity > best_match_score
                best_match_score := similarity
        
        // 80% 이상 유사하면 반전 가능성 높음
        pattern_reversal := best_match_score >= 0.8
    
    // AI 종합 판단
    if momentum_reversal and volatility_spike and pattern_reversal
        if price_momentum > 0
            ai_detected_high_reversal := true
            ai_detected_low_reversal := false
            ai_confidence := best_match_score
            ai_analysis_result := "AI 감지: 고점 반전 가능성 높음"
        else
            ai_detected_high_reversal := false
            ai_detected_low_reversal := true
            ai_confidence := best_match_score
            ai_analysis_result := "AI 감지: 저점 반전 가능성 높음"
    else
        ai_detected_high_reversal := false
        ai_detected_low_reversal := false
        ai_confidence := 0.0
        ai_analysis_result := "AI 분석: 반전 신호 없음"
    
    [ai_detected_high_reversal, ai_detected_low_reversal, ai_confidence, ai_analysis_result]

// 반전 시점 기준 패턴 추출
extract_pattern_around_reversal(reversal_type, reversal_bar) =>
    var int start_bar = 0
    var int end_bar = 0
    
    if reversal_type == "high"
        // 고점 반전: 반전 시점 기준 앞뒤 150캔들
        start_bar := reversal_bar - 75
        end_bar := reversal_bar + 75
    else if reversal_type == "low"
        // 저점 반전: 반전 시점 기준 앞뒤 150캔들
        start_bar := reversal_bar - 75
        end_bar := reversal_bar + 75
    else
        start_bar := 0
        end_bar := 0
    
    [start_bar, end_bar]

// AI 기반 실시간 분석 실행
[ai_high_reversal, ai_low_reversal, ai_confidence, ai_analysis] = ai_realtime_analysis()

// AI 기반 거래 결정 변수
var float ai_best_similarity = 0.0
var float ai_best_expected_return = 0.0
var float ai_best_pattern_quality = 0.0
var string ai_best_pattern_name = ""

// AI가 반전을 감지했을 때 패턴 매칭 수행
if ai_high_reversal or ai_low_reversal
    // AI가 현재 패턴을 분석
    current_curve = extract_center_curve(-75, 75)
    current_image = capture_chart_image(-75, 75)
    
    // AI가 성공 패턴들과 정밀 비교
    ai_best_similarity := 0.0
    ai_best_expected_return := 0.0
    ai_best_pattern_quality := 0.0
    ai_best_pattern_name := ""
    
    for i = 0 to array.size(successful_patterns) - 1
        pattern = array.get(successful_patterns, i)
        
        // AI 유사도 계산 (곡선 + 이미지)
        curve_sim = calculate_curve_similarity(current_curve, pattern.curve_points)
        image_sim = calculate_image_similarity(current_image, pattern.image_data)
        total_similarity = (curve_sim * 0.6 + image_sim * 0.4)
        
        if total_similarity > ai_best_similarity
            ai_best_similarity := total_similarity
            ai_best_expected_return := pattern.expected_return
            ai_best_pattern_quality := pattern.pattern_quality
            ai_best_pattern_name := pattern.pattern_name

// AI 기반 거래 결정 (AI가 직접 결정)
should_enter_long = (ai_low_reversal and ai_confidence >= 0.8 and ai_best_similarity >= 0.8 and ai_best_expected_return > 0 and in_trading_time and no_position)
should_enter_short = (ai_high_reversal and ai_confidence >= 0.8 and ai_best_similarity >= 0.8 and ai_best_expected_return < 0 and in_trading_time and no_position)

// 패턴별 동적 수익 목표 계산
calculate_pattern_profit_target(pattern) =>
    if na(pattern)
        [0.0, 0.0]
    else
        avg_profit = math.abs(pattern.expected_return)
        
        var float profit_target = 0.0
        if pattern.success_rate >= 0.8
            profit_target := avg_profit * 0.5  // 80% 이상 성공률이면 50%만 목표
        else if pattern.success_rate >= 0.7
            profit_target := avg_profit * 0.6  // 70% 이상 성공률이면 60% 목표
        else
            profit_target := avg_profit * 0.7  // 70% 미만이면 70% 목표
        
        stop_loss = profit_target * 0.3  // 손절매는 수익 목표의 30%로 설정
        [profit_target, stop_loss]

// AI 기반 반대 포지션 청산
if strategy.position_size > 0 and ai_high_reversal
    strategy.close("LONG_HYBRID_AI", comment="AI 반대 패턴 감지")
if strategy.position_size < 0 and ai_low_reversal
    strategy.close("SHORT_HYBRID_AI", comment="AI 반대 패턴 감지")

// AI 기반 거래 실행
if should_enter_long
    strategy.entry("LONG_HYBRID_AI", strategy.long)
    // 안전한 수익/손절 설정
    profit_target = math.max(0.01, math.min(0.05, best_expected_return))  // 1-5% 범위
    stop_loss = profit_target * 0.5  // 수익의 50% 손절
    strategy.exit("LONG_HYBRID_AI_EXIT", "LONG_HYBRID_AI", limit=close * (1 + profit_target), stop=close * (1 - stop_loss))
    
    if show_hybrid_results
        label.new(bar_index, low, "🟢 AI LONG\n패턴: " + best_pattern_name + "\n유사도: " + str.tostring(best_similarity * 100, "#.#") + "%\n예상수익: " + str.tostring(profit_target * 100, "#.#") + "%", 
                 color=color.green, textcolor=color.white, style=label.style_label_up)

if should_enter_short
    strategy.entry("SHORT_HYBRID_AI", strategy.short)
    // 안전한 수익/손절 설정
    profit_target = math.max(0.01, math.min(0.05, math.abs(best_expected_return)))  // 1-5% 범위
    stop_loss = profit_target * 0.5  // 수익의 50% 손절
    strategy.exit("SHORT_HYBRID_AI_EXIT", "SHORT_HYBRID_AI", limit=close * (1 - profit_target), stop=close * (1 + stop_loss))
    
    if show_hybrid_results
        label.new(bar_index, high, "🔴 AI SHORT\n패턴: " + best_pattern_name + "\n유사도: " + str.tostring(best_similarity * 100, "#.#") + "%\n예상수익: " + str.tostring(profit_target * 100, "#.#") + "%", 
                 color=color.red, textcolor=color.white, style=label.style_label_down)

// ============================================================================
// 시각화 및 디버깅
// ============================================================================

// 하이브리드 분석 결과 표시 (실시간 업데이트)
if show_hybrid_results
    var table hybrid_table = table.new(position.top_right, 3, 10, bgcolor=color.white, border_width=1)
    
    // 테이블 헤더
    table.cell(hybrid_table, 0, 0, "하이브리드 AI", text_color=color.black, bgcolor=color.gray)
    table.cell(hybrid_table, 1, 0, "값", text_color=color.black, bgcolor=color.gray)
    table.cell(hybrid_table, 2, 0, "상태", text_color=color.black, bgcolor=color.gray)
    
    // AI 분석 결과
    table.cell(hybrid_table, 0, 1, "AI 분석", text_color=color.black)
    table.cell(hybrid_table, 1, 1, ai_analysis, text_color=color.black)
    table.cell(hybrid_table, 2, 1, (ai_high_reversal or ai_low_reversal) ? "🤖" : "⏳", text_color=color.black)
    
    // 1차 곡선 유사도
    table.cell(hybrid_table, 0, 2, "1차 곡선 유사도", text_color=color.black)
    curve_sim = calculate_curve_similarity(extract_center_curve(0, pattern_candles - 1), extract_center_curve(0, pattern_candles - 1))
    table.cell(hybrid_table, 1, 2, str.tostring(curve_sim, "#.##"), text_color=color.black)
    table.cell(hybrid_table, 2, 2, curve_sim >= curve_similarity_threshold ? "✅" : "❌", text_color=color.black)
    
    // AI 신뢰도
    table.cell(hybrid_table, 0, 3, "AI 신뢰도", text_color=color.black)
    table.cell(hybrid_table, 1, 3, str.tostring(ai_confidence, "#.##"), text_color=color.black)
    table.cell(hybrid_table, 2, 3, ai_confidence >= 0.8 ? "✅" : "❌", text_color=color.black)
    
    // AI 최고 유사도
    table.cell(hybrid_table, 0, 4, "AI 유사도", text_color=color.black)
    table.cell(hybrid_table, 1, 4, str.tostring(ai_best_similarity, "#.##"), text_color=color.black)
    table.cell(hybrid_table, 2, 4, ai_best_similarity >= 0.8 ? "✅" : "❌", text_color=color.black)
    
    // AI 예상 수익률
    table.cell(hybrid_table, 0, 5, "AI 예상수익", text_color=color.black)
    table.cell(hybrid_table, 1, 5, str.tostring(ai_best_expected_return * 100, "#.#") + "%", text_color=color.black)
    table.cell(hybrid_table, 2, 5, ai_best_expected_return > 0 ? "📈" : "📉", text_color=color.black)
    
    // AI 패턴 이름
    table.cell(hybrid_table, 0, 6, "AI 패턴", text_color=color.black)
    table.cell(hybrid_table, 1, 6, ai_best_pattern_name, text_color=color.black)
    table.cell(hybrid_table, 2, 6, ai_best_pattern_name != "" ? "🎯" : "⏳", text_color=color.black)
    
    // 거래 신호
    table.cell(hybrid_table, 0, 7, "거래 신호", text_color=color.black)
    signal_text = should_enter_long ? "🟢 LONG" : should_enter_short ? "🔴 SHORT" : "⏸️ 대기"
    table.cell(hybrid_table, 1, 7, signal_text, text_color=color.black)
    table.cell(hybrid_table, 2, 7, (should_enter_long or should_enter_short) ? "🚀" : "⏳", text_color=color.black)
    
    // AI 매칭 상태
    table.cell(hybrid_table, 0, 8, "AI 매칭", text_color=color.black)
    ai_match_status = ai_confidence >= 0.8 and ai_best_similarity >= 0.8 ? "매칭완료" : "분석중"
    table.cell(hybrid_table, 1, 8, ai_match_status, text_color=color.black)
    table.cell(hybrid_table, 2, 8, ai_confidence >= 0.8 and ai_best_similarity >= 0.8 ? "🤖" : "⏳", text_color=color.black)
    
    // 거래 통계 (실시간)
    table.cell(hybrid_table, 0, 9, "거래 통계", text_color=color.black)
    trade_stats = "총거래: " + str.tostring(strategy.closedtrades) + " 승률: " + str.tostring(strategy.wintrades / math.max(strategy.closedtrades, 1) * 100, "#.#") + "%"
    table.cell(hybrid_table, 1, 9, trade_stats, text_color=color.black)
    table.cell(hybrid_table, 2, 9, "📊", text_color=color.black)
