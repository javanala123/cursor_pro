//@version=6
strategy("Pattern Trading Bot - 최종 완성판", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=2)

// ============================================================================
// 차트 타입 확인 및 경고 (실제 구현)
// ============================================================================

// 표준 차트인지 확인 (실제 로직 구현)
is_standard_chart() =>
    // 하이킨 아시, 렌코, 카기 등 비표준 차트 감지
    is_standard = true
    
    // 하이킨 아시 감지: close가 (open+high+low+close)/4와 같음
    ha_close = (open + high + low + close) / 4
    if math.abs(close - ha_close) < 0.0001
        is_standard := false
    
    // 렌코 감지: 연속된 같은 가격이 많음 (4개 이상)
    same_price_count = 0
    for i = 0 to 3
        if close[i] == close[i+1]
            same_price_count += 1
    
    if same_price_count >= 3
        is_standard := false
    
    // 카기 감지: 가격 변화가 매우 극단적
    price_change = math.abs(close - close[1]) / close[1]
    if price_change > 0.1  // 10% 이상 변화
        is_standard := false
    
    is_standard

// ============================================================================
// 설정 및 변수
// ============================================================================

// 백테스트 기간 설정
start_date = input.time(timestamp("2019-01-01 00:00"), "백테스트 시작일")
end_date = input.time(timestamp("2024-01-01 00:00"), "백테스트 종료일")

// 패턴 감지 설정
min_confidence = input.float(0.4, "최소 신뢰도", minval=0.0, maxval=1.0)
min_strength = input.float(0.2, "최소 강도", minval=0.0, maxval=1.0)

// 위험 관리 설정
stop_loss_pct = input.float(0.02, "손절매 비율", minval=0.01, maxval=0.1)
max_risk_per_trade = input.float(0.02, "거래당 최대 위험", minval=0.01, maxval=0.05)

// ta 함수들을 전역 변수로 선언 (일관성 보장)
pivot_low_5 = ta.pivotlow(low, 5, 5)
pivot_high_5 = ta.pivothigh(high, 5, 5)
range_avg_20 = ta.sma(high - low, 20)

// ============================================================================
// 타임프레임별 수익 목표 (실제 사용)
// ============================================================================

// 현재 타임프레임 감지
get_current_timeframe() =>
    tf = timeframe.in_seconds()
    if tf <= 300  // 5분 이하
        "5m"
    else if tf <= 900  // 15분 이하
        "15m"
    else if tf <= 3600  // 1시간 이하
        "1h"
    else if tf <= 14400  // 4시간 이하
        "4h"
    else
        "1d"

// 타임프레임별 수익 목표 (퍼센트 기준)
get_profit_target_pct(timeframe) =>
    switch timeframe
        "5m" => 0.005   // 0.5%
        "15m" => 0.01   // 1%
        "1h" => 0.02    // 2%
        "4h" => 0.04    // 4%
        "1d" => 0.08    // 8%
        => 0.01

// ============================================================================
// 패턴 감지 함수들 (수정된 버전)
// ============================================================================

// 1. 엔걸핑 패턴 감지
detect_engulfing() =>
    bullish_engulfing = close[1] < open[1] and close > open and close > open[1] and open < close[1]
    bearish_engulfing = close[1] > open[1] and close < open and close < open[1] and open > close[1]
    [bullish_engulfing, bearish_engulfing]

// 2. 해머 패턴 감지 (수정된 버전)
detect_hammer() =>
    body_size = math.abs(close - open)
    lower_shadow = math.min(open, close) - low
    upper_shadow = high - math.max(open, close)
    total_range = high - low
    
    // 해머 조건: 아랫꼬리가 몸통의 2배 이상, 윗꼬리는 몸통보다 작음
    hammer = lower_shadow > 2 * body_size and upper_shadow < body_size and total_range > 0
    
    // 상승 해머: 하락 후 반등
    bullish_hammer = hammer and close > open
    // 하락 해머: 상승 후 하락 (드물지만 가능)
    bearish_hammer = hammer and close < open
    
    [bullish_hammer, bearish_hammer]

// 3. 도지 패턴 감지 (수정된 버전)
detect_doji() =>
    body_size = math.abs(close - open)
    total_range = high - low
    doji = total_range > 0 and body_size <= total_range * 0.05
    
    // 도지는 방향성이 없으므로 추세 방향으로 거래
    bullish_doji = doji and close > close[1]  // 상승 추세
    bearish_doji = doji and close < close[1]  // 하락 추세
    
    [bullish_doji, bearish_doji]

// 4. 더블 바텀 패턴 감지 (수정된 버전)
detect_double_bottom() =>
    double_bottom = false
    
    if not na(pivot_low_5)
        // 이전 피벗 로우와 비교
        prev_pivot = pivot_low_5[10]
        if not na(prev_pivot)
            // 두 피벗이 비슷한 높이인지 확인
            if math.abs(pivot_low_5 - prev_pivot) <= range_avg_20 * 0.02
                double_bottom := true
    
    [double_bottom, false]

// 5. 더블 탑 패턴 감지 (수정된 버전)
detect_double_top() =>
    double_top = false
    
    if not na(pivot_high_5)
        // 이전 피벗 하이와 비교
        prev_pivot = pivot_high_5[10]
        if not na(prev_pivot)
            // 두 피벗이 비슷한 높이인지 확인
            if math.abs(pivot_high_5 - prev_pivot) <= range_avg_20 * 0.02
                double_top := true
    
    [false, double_top]

// ============================================================================
// 패턴 강도 및 신뢰도 계산
// ============================================================================

calculate_pattern_strength(pattern_type, is_bullish) =>
    strength = switch pattern_type
        "engulfing" => 
            body_size = math.abs(close - open)
            prev_body_size = math.abs(close[1] - open[1])
            prev_body_size > 0 ? math.min(1.0, body_size / prev_body_size) : 0.0
        "hammer" => 
            body_size = math.abs(close - open)
            lower_shadow = math.min(open, close) - low
            total_range = high - low
            total_range > 0 ? math.min(1.0, lower_shadow / total_range) : 0.0
        "doji" => 
            body_size = math.abs(close - open)
            total_range = high - low
            total_range > 0 ? 1.0 - (body_size / total_range) : 0.0
        "double_bottom" => 0.8
        "double_top" => 0.8
        => 0.0
    strength

calculate_pattern_confidence(pattern_type, is_bullish) =>
    confidence = switch pattern_type
        "engulfing" => 0.85
        "hammer" => 0.80
        "doji" => 0.75
        "double_bottom" => 0.90
        "double_top" => 0.90
        => 0.0
    confidence

// ============================================================================
// 거래 조건 및 실행
// ============================================================================

// 거래 가능한 시간인지 확인
in_trading_time = time >= start_date and time <= end_date

// 포지션이 없을 때만 거래
no_position = strategy.position_size == 0

// 표준 차트인지 확인
is_standard = is_standard_chart()

// 거래 조건 확인 (차트 타입 확인 강화)
should_enter_trade(confidence, strength) =>
    // 기본 조건
    basic_conditions = confidence >= min_confidence and strength >= min_strength and in_trading_time and no_position
    
    // 차트 타입 확인 (비표준 차트에서는 거래 금지)
    chart_condition = is_standard
    
    // 모든 조건 만족 시에만 거래
    basic_conditions and chart_condition

// 수익 목표 및 손절매 계산
calculate_targets() =>
    current_tf = get_current_timeframe()
    profit_pct = get_profit_target_pct(current_tf)
    
    profit_target = close * profit_pct
    stop_loss = close * stop_loss_pct
    
    [profit_target, stop_loss]

// ============================================================================
// 패턴 감지 및 거래 실행
// ============================================================================

// 패턴 감지
[bull_engulfing, bear_engulfing] = detect_engulfing()
[bull_hammer, bear_hammer] = detect_hammer()
[bull_doji, bear_doji] = detect_doji()
[bull_double_bottom, _] = detect_double_bottom()
[_, bear_double_top] = detect_double_top()

// 라벨 관리 (중복 방지)
var label current_label = na

// 1. 엔걸핑 패턴 거래
if bull_engulfing
    confidence = calculate_pattern_confidence("engulfing", true)
    strength = calculate_pattern_strength("engulfing", true)
    if should_enter_trade(confidence, strength)
        [profit_target, stop_loss] = calculate_targets()
        strategy.entry("LONG_ENGULF", strategy.long)
        strategy.exit("LONG_ENGULF_EXIT", "LONG_ENGULF", limit=close + profit_target, stop=close - stop_loss)
        
        label.delete(current_label)
        current_label := label.new(bar_index, low, "🟢 엔걸핑\nC:" + str.tostring(confidence, "#.##") + " S:" + str.tostring(strength, "#.##"), color=color.green, textcolor=color.white, style=label.style_label_up)

if bear_engulfing
    confidence = calculate_pattern_confidence("engulfing", false)
    strength = calculate_pattern_strength("engulfing", false)
    if should_enter_trade(confidence, strength)
        [profit_target, stop_loss] = calculate_targets()
        strategy.entry("SHORT_ENGULF", strategy.short)
        strategy.exit("SHORT_ENGULF_EXIT", "SHORT_ENGULF", limit=close - profit_target, stop=close + stop_loss)
        
        label.delete(current_label)
        current_label := label.new(bar_index, high, "🔴 엔걸핑\nC:" + str.tostring(confidence, "#.##") + " S:" + str.tostring(strength, "#.##"), color=color.red, textcolor=color.white, style=label.style_label_down)

// 2. 해머 패턴 거래
if bull_hammer
    confidence = calculate_pattern_confidence("hammer", true)
    strength = calculate_pattern_strength("hammer", true)
    if should_enter_trade(confidence, strength)
        [profit_target, stop_loss] = calculate_targets()
        strategy.entry("LONG_HAMMER", strategy.long)
        strategy.exit("LONG_HAMMER_EXIT", "LONG_HAMMER", limit=close + profit_target, stop=close - stop_loss)
        
        label.delete(current_label)
        current_label := label.new(bar_index, low, "🔨 해머\nC:" + str.tostring(confidence, "#.##") + " S:" + str.tostring(strength, "#.##"), color=color.blue, textcolor=color.white, style=label.style_label_up)

if bear_hammer
    confidence = calculate_pattern_confidence("hammer", false)
    strength = calculate_pattern_strength("hammer", false)
    if should_enter_trade(confidence, strength)
        [profit_target, stop_loss] = calculate_targets()
        strategy.entry("SHORT_HAMMER", strategy.short)
        strategy.exit("SHORT_HAMMER_EXIT", "SHORT_HAMMER", limit=close - profit_target, stop=close + stop_loss)
        
        label.delete(current_label)
        current_label := label.new(bar_index, high, "🔨 해머\nC:" + str.tostring(confidence, "#.##") + " S:" + str.tostring(strength, "#.##"), color=color.orange, textcolor=color.white, style=label.style_label_down)

// 3. 도지 패턴 거래
if bull_doji
    confidence = calculate_pattern_confidence("doji", true)
    strength = calculate_pattern_strength("doji", true)
    if should_enter_trade(confidence, strength)
        [profit_target, stop_loss] = calculate_targets()
        strategy.entry("LONG_DOJI", strategy.long)
        strategy.exit("LONG_DOJI_EXIT", "LONG_DOJI", limit=close + profit_target, stop=close - stop_loss)
        
        label.delete(current_label)
        current_label := label.new(bar_index, low, "⚪ 도지(상승)\nC:" + str.tostring(confidence, "#.##") + " S:" + str.tostring(strength, "#.##"), color=color.lime, textcolor=color.black, style=label.style_label_up)

if bear_doji
    confidence = calculate_pattern_confidence("doji", false)
    strength = calculate_pattern_strength("doji", false)
    if should_enter_trade(confidence, strength)
        [profit_target, stop_loss] = calculate_targets()
        strategy.entry("SHORT_DOJI", strategy.short)
        strategy.exit("SHORT_DOJI_EXIT", "SHORT_DOJI", limit=close - profit_target, stop=close + stop_loss)
        
        label.delete(current_label)
        current_label := label.new(bar_index, high, "⚪ 도지(하락)\nC:" + str.tostring(confidence, "#.##") + " S:" + str.tostring(strength, "#.##"), color=color.orange, textcolor=color.white, style=label.style_label_down)

// 4. 더블 바텀 패턴 거래
if bull_double_bottom
    confidence = calculate_pattern_confidence("double_bottom", true)
    strength = calculate_pattern_strength("double_bottom", true)
    if should_enter_trade(confidence, strength)
        [profit_target, stop_loss] = calculate_targets()
        strategy.entry("LONG_DOUBLE_BOTTOM", strategy.long)
        strategy.exit("LONG_DOUBLE_BOTTOM_EXIT", "LONG_DOUBLE_BOTTOM", limit=close + profit_target, stop=close - stop_loss)
        
        label.delete(current_label)
        current_label := label.new(bar_index, low, "📈 더블바텀\nC:" + str.tostring(confidence, "#.##") + " S:" + str.tostring(strength, "#.##"), color=color.purple, textcolor=color.white, style=label.style_label_up)

// 5. 더블 탑 패턴 거래
if bear_double_top
    confidence = calculate_pattern_confidence("double_top", false)
    strength = calculate_pattern_strength("double_top", false)
    if should_enter_trade(confidence, strength)
        [profit_target, stop_loss] = calculate_targets()
        strategy.entry("SHORT_DOUBLE_TOP", strategy.short)
        strategy.exit("SHORT_DOUBLE_TOP_EXIT", "SHORT_DOUBLE_TOP", limit=close - profit_target, stop=close + stop_loss)
        
        label.delete(current_label)
        current_label := label.new(bar_index, high, "📉 더블탑\nC:" + str.tostring(confidence, "#.##") + " S:" + str.tostring(strength, "#.##"), color=color.maroon, textcolor=color.white, style=label.style_label_down)

// ============================================================================
// 차트 타입 경고 표시
// ============================================================================

// 비표준 차트 감지 시 경고
if not is_standard
    var label warning_label = na
    if na(warning_label)
        warning_label := label.new(bar_index, high, "⚠️ 비표준 차트 감지!\n하이킨 아시, 렌코, 카기 등은\n비현실적인 백테스트 결과를 냅니다.\n일반 캔들스틱 차트를 사용하세요!", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.large)
    
    // 경고 라벨을 최신 바에 유지
    label.set_xy(warning_label, bar_index, high)

// 표준 차트 사용 시 확인 메시지
if is_standard and barstate.islast
    var label success_label = na
    if na(success_label)
        success_label := label.new(bar_index, low, "✅ 표준 차트 사용 중\n정확한 백테스트 결과를 제공합니다!", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.normal)
